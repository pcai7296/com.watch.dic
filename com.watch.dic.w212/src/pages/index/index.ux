        </div>
      </div>

      <div class="m-bottom">
        <div class="m-circle" onclick="goAbout">
          <image class="m-circle-icon" src="/common/icons/btn_info_i.png" style="width:30px;height:30px;" />
        </div>
        <div class="m-circle m-circle-ml" onclick="goSponsor">
          <image class="m-circle-icon" src="/common/icons/btn_heart_gold.png" style="width:30px;height:30px;" />
        </div>
      </div>
    </div>

    <!-- ===== 布局二：经典 (classic) ===== -->
    <div if="{{layoutMode === 'classic'}}" class="classic-wrap">
      <div class="icon-card icon-card-{{screenProfile}} c-icon-card">
        <img class="deco-icon deco-icon-{{screenProfile}}" src="/common/logo.png" />
      </div>

      <text class="title title-{{screenProfile}} c-title">腕上词典</text>
      <text class="subtitle subtitle-{{screenProfile}}">抬手即查</text>

      <div class="main-button main-button-{{screenProfile}} secondary-button c-main-btn" onclick="goSearch">
        <img class="btn-icon btn-icon-{{screenProfile}}" src="/common/icons/btn_search.png" />
        <text class="btn-label">查单词</text>
      </div>

      <div class="button-group button-group-{{screenProfile}}">
        <div class="grid-button grid-button-{{screenProfile}}" onclick="goInflectSearch">
          <img class="grid-btn-icon grid-btn-icon-{{screenProfile}}" src="/common/icons/btn_transform.png" />
          <text class="grid-btn-text">变形</text>
        </div>
