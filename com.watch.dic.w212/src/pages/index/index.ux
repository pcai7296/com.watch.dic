          <img class="grid-btn-icon grid-btn-icon-{{screenProfile}}" src="/common/icons/btn_about.png" />
          <text class="grid-btn-text">设置</text>
        </div>
        <div class="grid-button grid-button-{{screenProfile}}" onclick="goHistory">
