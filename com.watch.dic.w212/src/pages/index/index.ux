<template>
  <div class="page page-{{screenProfile}}">
    <!-- 共用：时间显示 -->
    <text class="time-display">17:23</text>

    <!-- ===== 布局一：简约 (minimal) ===== -->
    <div if="{{layoutMode === 'minimal'}}" class="layout-minimal">
      <text class="title">腕上词典</text>
      <img class="logo-icon" src="/common/logo.png" />
      <div class="btn-list">
        <div class="main-btn" onclick="goSearch">
          <img class="btn-icon" src="/common/icons/btn_search.png" />
          <text class="btn-label">查单词</text>
        </div>
        <div class="main-btn btn-mt" onclick="goHistory">
          <img class="btn-icon" src="/common/icons/btn_history.png" />
          <text class="btn-label">历史记录</text>
        </div>
        <div class="main-btn btn-mt" onclick="goFavorites">
          <img class="btn-icon" src="/common/icons/btn_fav.png" />
          <text class="btn-label">我的收藏</text>
        </div>
      </div>
      <div class="bottom-row">
        <div class="circle-btn" onclick="goAbout">
          <img class="circle-icon" src="/common/icons/btn_about.png" />
        </div>
        <div class="circle-btn circle-btn-ml" onclick="goSponsor">
          <img class="circle-icon" src="/common/icons/btn_sponsor.png" />
        </div>
      </div>
    </div>

    <!-- ===== 布局二：经典 (classic) ===== -->
    <div if="{{layoutMode === 'classic'}}" class="layout-classic">
      <img class="logo-icon logo-icon-classic" src="/common/logo.png" />
      <text class="title">腕上词典</text>
      <text class="subtitle">抬手即查</text>
      <div class="cta-btn" onclick="goSearch">
        <img class="cta-icon" src="/common/icons/btn_search.png" />
        <text class="cta-label">查单词</text>
      </div>
      <div class="grid">
        <div class="grid-btn" onclick="goInflectSearch">
          <img class="grid-icon" src="/common/icons/btn_transform.png" />
          <text class="grid-label">变形</text>
        </div>
        <div class="grid-btn grid-btn-ml" onclick="goSettings">
          <img class="grid-icon" src="/common/icons/btn_about.png" />
          <text class="grid-label">设置</text>
        </div>
        <div class="grid-btn grid-btn-mt" onclick="goHistory">
          <img class="grid-icon" src="/common/icons/btn_history.png" />
          <text class="grid-label">历史</text>
        </div>
        <div class="grid-btn grid-btn-ml grid-btn-mt" onclick="goFavorites">
          <img class="grid-icon" src="/common/icons/btn_fav.png" />
          <text class="grid-label">收藏</text>
        </div>
      </div>
      <div class="bottom-row-classic">
        <div class="small-btn" onclick="goAbout">
          <img class="small-icon" src="/common/icons/btn_about.png" />
          <text class="small-label">关于</text>
        </div>
        <div class="small-btn small-btn-ml" onclick="goSponsor">
          <img class="small-icon" src="/common/icons/btn_sponsor.png" />
          <text class="small-label">赞助</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import device from "@system.device"
import storage from "@system.storage"
import router from "@system.router"
import buildTarget from "../../common/buildTarget"

export default {
  private: {
    screenProfile: buildTarget.profile,
    layoutMode: "minimal"
  },

  onInit() {
    var app = this.$app.$def
    this.screenProfile = buildTarget.profile
    device.getInfo({
      success: function(data) {
        app.updateScreenInfo(data)
      }.bind(this),
      fail: function(data, code) {
        console.log("index device.getInfo failed; using compiled target: " + code)
      }.bind(this)
    })
    this._loadLayout()
    this._cleanInvalidHistory()
    this._trackLaunch()
  },

  _loadLayout() {
    var self = this
    storage.get({
      key: "dic_home_layout",
      default: "minimal",
      success: function(data) {
        var value = data && (data.value || data)
        if (value === "classic" || value === "minimal") {
          self.layoutMode = value
        }
      },
      fail: function() {}
    })
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: function(data) {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: function(setData, code) {
            console.log("index launch count save failed: " + code)
          }
        })
        if (nextCount === 1 || nextCount % 10 === 0) {
          this.goSponsor()
        }
      }.bind(this),
      fail: function(getData, code) {
        console.log("index launch count read failed: " + code)
        this.goSponsor()
      }.bind(this)
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return

        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }

        if (clean.length < list.length) {
          storage.set({
            key: "dic_history",
            value: JSON.stringify(clean)
          })
        }
      },
      fail: function() {}
    })
  },

  goInflectSearch() {
    router.push({
      uri: "/pages/search",
      params: {
        searchMode: "inflect",
        inflectDepth: "0"
      }
    })
  },

  goSearch() {
    router.push({
      uri: "/pages/search"
    })
  },

  goSettings() {
    router.push({
      uri: "/pages/settings"
    })
  },

  goHistory() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
      }
    })
  },

  goAbout() {
    router.push({
      uri: "/pages/about"
    })
  },

  goSponsor() {
    router.push({
      uri: "/pages/sponsor"
    })
  }
}
</script>

