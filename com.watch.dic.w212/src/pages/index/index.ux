<template>
  <div class="page page-{{screenProfile}}">
    <!-- 共用：时间显示 -->
    <text class="time-display time-display-{{screenProfile}}">{{currentTime}}</text>

    <!-- ===== 布局一：简约 (minimal) ===== -->
    <div if="{{layoutMode === 'minimal'}}" class="layout-minimal">
      <text class="title title-{{screenProfile}}">腕上词典</text>
      <div class="icon-card icon-card-{{screenProfile}}">
        <img class="deco-icon deco-icon-{{screenProfile}}" src="/common/logo.png" />
      </div>
      <div class="btn-list">
        <div class="main-btn main-btn-{{screenProfile}}" @click="goSearch">
          <img class="btn-icon" src="/common/icons/btn_search.png" />
          <text class="btn-label">查单词</text>
        </div>
        <div class="main-btn main-btn-{{screenProfile}}" @click="goHistory">
          <img class="btn-icon" src="/common/icons/btn_history.png" />
          <text class="btn-label">历史记录</text>
        </div>
        <div class="main-btn main-btn-{{screenProfile}}" @click="goFavorites">
          <img class="btn-icon" src="/common/icons/btn_fav.png" />
          <text class="btn-label">我的收藏</text>
        </div>
      </div>
      <div class="bottom-row-minimal">
        <div class="circle-btn" @click="goAbout">
          <img class="circle-btn-icon" src="/common/icons/btn_about.png" />
        </div>
        <div class="circle-btn" @click="goSponsor">
          <img class="circle-btn-icon" src="/common/icons/btn_sponsor.png" />
        </div>
      </div>
    </div>

    <!-- ===== 布局二：经典 (classic) ===== -->
    <div if="{{layoutMode === 'classic'}}" class="layout-classic">
      <div class="icon-card icon-card-{{screenProfile}}">
        <img class="deco-icon deco-icon-{{screenProfile}}" src="/common/logo.png" />
      </div>
      <text class="title title-{{screenProfile}}">腕上词典</text>
      <text class="subtitle subtitle-{{screenProfile}}">抬手即查</text>
      <div class="cta-btn cta-btn-{{screenProfile}}" @click="goSearch">
        <img class="cta-icon" src="/common/icons/btn_search.png" />
        <text class="cta-label">查单词</text>
      </div>
      <div class="grid grid-{{screenProfile}}">
        <div class="grid-btn grid-btn-{{screenProfile}}" @click="goInflectSearch">
          <img class="grid-icon" src="/common/icons/btn_transform.png" />
          <text class="grid-label">变形</text>
        </div>
        <div class="grid-btn grid-btn-{{screenProfile}}" @click="goSettings">
          <img class="grid-icon" src="/common/icons/btn_about.png" />
          <text class="grid-label">设置</text>
        </div>
        <div class="grid-btn grid-btn-{{screenProfile}}" @click="goHistory">
          <img class="grid-icon" src="/common/icons/btn_history.png" />
          <text class="grid-label">历史</text>
        </div>
        <div class="grid-btn grid-btn-{{screenProfile}}" @click="goFavorites">
          <img class="grid-icon" src="/common/icons/btn_fav.png" />
          <text class="grid-label">收藏</text>
        </div>
      </div>
      <div class="bottom-row bottom-row-{{screenProfile}}">
        <div class="small-button small-button-{{screenProfile}} about-button" @click="goAbout">
          <img class="btn-icon-sm" src="/common/icons/btn_about.png" />
          <text class="btn-label-sm">关于</text>
        </div>
        <div class="small-button small-button-{{screenProfile}} sponsor-button" @click="goSponsor">
          <img class="btn-icon-sm" src="/common/icons/btn_sponsor.png" />
          <text class="btn-label-sm">赞助</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import device from "@system.device"
import storage from "@system.storage"
import router from "@system.router"
import buildTarget from "../../common/buildTarget"

export default {
  private: {
    screenProfile: buildTarget.profile,
    layoutMode: "minimal",
    currentTime: ""
  },

  onInit() {
    const app = this.$app.$def
    this.screenProfile = buildTarget.profile
    device.getInfo({
      success: (data) => {
        app.updateScreenInfo(data)
        this.screenProfile = app.data.screenProfile
      },
      fail: (data, code) => {
        console.log("index device.getInfo failed; using compiled target: " + code)
      }
    })
    this._loadLayout()
    this._updateTime()
    this._cleanInvalidHistory()
    this._trackLaunch()
  },

  _loadLayout() {
    storage.get({
      key: "dic_home_layout",
      default: "minimal",
      success: (data) => {
        const value = data && (data.value || data)
        if (value === "classic" || value === "minimal") {
          this.layoutMode = value
        }
      },
      fail: () => {}
    })
  },

  _updateTime() {
    const now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    this.currentTime = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: (data) => {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: (setData, code) => {
            console.log("index launch count save failed: " + code)
          }
        })
        if (nextCount === 1 || nextCount % 10 === 0) {
          this.goSponsor()
        }
      },
      fail: (getData, code) => {
        console.log("index launch count read failed: " + code)
        this.goSponsor()
      }
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return

        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }

        if (clean.length < list.length) {
          storage.set({
            key: "dic_history",
            value: JSON.stringify(clean)
          })
        }
      },
      fail: function() {}
    })
  },

  goInflectSearch() {
    router.push({
      uri: "/pages/search",
      params: {
        searchMode: "inflect",
        inflectDepth: "0"
      }
    })
  },

  goSearch() {
    router.push({
      uri: "/pages/search"
    })
  },

  goSettings() {
    router.push({
      uri: "/pages/settings"
    })
  },

  goHistory() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
      }
    })
  },

  goAbout() {
    router.push({
      uri: "/pages/about"
    })
  },

  goSponsor() {
    router.push({
      uri: "/pages/sponsor"
    })
  }
}
</script>

