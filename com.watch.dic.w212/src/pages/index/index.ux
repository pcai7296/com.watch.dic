          <text class="grid-btn-text">历史</text>
        </div>
        <div class="grid-button grid-button-{{screenProfile}}" onclick="goFavorites">
          <img class="grid-btn-icon grid-btn-icon-{{screenProfile}}" src="/common/icons/btn_fav.png" />
          <text class="grid-btn-text">收藏</text>
        </div>
      </div>

      <div class="bottom-row bottom-row-{{screenProfile}}">
        <div class="small-button small-button-{{screenProfile}} about-button" onclick="goAbout">
          <img class="btn-icon-sm" src="/common/icons/btn_about.png" />
          <text class="btn-label-sm">关于</text>
        </div>
        <div class="small-button small-button-{{screenProfile}} sponsor-button" onclick="goSponsor">
          <img class="btn-icon-sm" src="/common/icons/btn_sponsor.png" />
          <text class="btn-label-sm">赞助</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import device from "@system.device"
import storage from "@system.storage"
import router from "@system.router"
import buildTarget from "../../common/buildTarget"

export default {
  private: {
    screenProfile: buildTarget.profile,
    layoutMode: "minimal",
    currentTime: "",
    tc0: "", tc1: "", tc2: "", tc3: "", tc4: ""
  },

  onInit() {
    var app = this.$app.$def
    this.screenProfile = buildTarget.profile
    device.getInfo({
      success: function(data) {
        app.updateScreenInfo(data)
      }.bind(this),
      fail: function(data, code) {
        console.log("index device.getInfo failed; using compiled target: " + code)
      }.bind(this)
    })
    this._updateTime()
    this._loadLayout()
    this._cleanInvalidHistory()
    this._trackLaunch()
  },

  _updateTime() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    var t = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m
    this.tc0 = t[0]
    this.tc1 = t[1]
    this.tc2 = t[2]
    this.tc3 = t[3]
    this.tc4 = t[4]
  },

  _loadLayout() {
    var self = this
    storage.get({
      key: "dic_home_layout",
      default: "minimal",
      success: function(data) {
        var value = data && (data.value || data)
        if (value === "classic" || value === "minimal") {
          self.layoutMode = value
        }
      },
      fail: function() {}
    })
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: function(data) {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: function(setData, code) {
            console.log("index launch count save failed: " + code)
          }
        })
        if (nextCount === 1 || nextCount % 10 === 0) {
          this.goSponsor()
        }
      }.bind(this),
      fail: function(getData, code) {
        console.log("index launch count read failed: " + code)
        this.goSponsor()
      }.bind(this)
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return
        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }
        if (clean.length < list.length) {
          storage.set({ key: "dic_history", value: JSON.stringify(clean) })
        }
      },
      fail: function() {}
    })
  },

  goInflectSearch() {
    router.push({ uri: "/pages/search", params: { searchMode: "inflect", inflectDepth: "0" } })
  },
  goSearch() {
    router.push({ uri: "/pages/search" })
  },
  goSettings() {
    router.push({ uri: "/pages/settings" })
  },
  goHistory() {
    router.push({ uri: "/pages/records", params: { type: "history" } })
  },
  goFavorites() {
    router.push({ uri: "/pages/records", params: { type: "favorites" } })
  },
  goAbout() {
    router.push({ uri: "/pages/about" })
  },
  goSponsor() {
    router.push({ uri: "/pages/sponsor" })
  }
}
</script>

