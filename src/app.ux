<script>
import "./global"
import {loadDictionaryProfile} from "./common/dictProfile"

export default {
  data: {
    screenShape: "circle",
    screenWidth: 466,
    screenHeight: 466,
    screenAspectRatio: 466 / 466,
    screenProfile: "circle"
  },

  onCreate() {
    console.log("app created")
    loadDictionaryProfile(function(profile) {
      console.log("dict profile loaded: " + (profile && profile.profile ? profile.profile : "unknown"))
    })
    console.log("fixed W466 screen: circle 466x466")
  },

  onDestroy() {
    console.log("app destroyed")
  }
}
</script>
