<template>
  <div class="page page-{{screenClass}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <image class="back-btn" src="/common/icons/btn_back.png" onclick="goBack" />

    <list class="about-list about-list-{{screenClass}}" style="width: {{layoutWidth}}px;" onscroll="onListScroll">
      <list-item type="card" class="list-item" style="width: {{layoutWidth}}px; height: 250px;">
        <div class="app-card app-card-{{screenClass}}">
          <text class="app-name">腕上词典</text>
          <text class="app-version">{{versionName}}</text>
          <img class="deco-icon-about" src="/common/logo.png" />
        </div>
      </list-item>

      <list-item type="devs" class="list-item" style="width: {{layoutWidth}}px; height: 170px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">Developers</text>
          <text class="dev-role" style="{{devLineStyle}}">开发</text>
          <text class="dev-name" style="{{devLineStyle}}">@睡不着的鸿鹄</text>
          <text class="dev-role" style="{{devLineStyle}}">UI设计参考</text>
          <text class="dev-name" style="{{devLineStyle}}">@无源流沙</text>
        </div>
      </list-item>

      <list-item type="license" class="list-item" style="width: {{layoutWidth}}px; height: {{licenseHeight}}px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">词库来源</text>
          <text class="license-line" style="{{descLineStyle}}" for="{{ line in licenseLines }}">{{ line }}</text>
        </div>
      </list-item>

      <list-item type="usage" class="list-item" style="width: {{layoutWidth}}px; height: {{usageHeight}}px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">使用说明</text>
          <text class="desc-line" style="{{descLineStyle}}" for="{{ line in usageLines }}">{{ line }}</text>
        </div>
      </list-item>

      <list-item type="limits" class="list-item" style="width: {{layoutWidth}}px; height: {{limitsHeight}}px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">使用限制</text>
          <text class="desc-line" style="{{descLineStyle}}" for="{{ line in limitLines }}">{{ line }}</text>
        </div>
      </list-item>

      <list-item type="tags" class="list-item" style="width: {{layoutWidth}}px; height: {{tagsHeight}}px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">标签缩写</text>
          <text class="desc-line" style="{{descLineStyle}}" for="{{ line in tagLines }}">{{ line }}</text>
        </div>
      </list-item>

      <list-item type="pos" class="list-item" style="width: {{layoutWidth}}px; height: {{posHeight}}px;">
        <div class="section-inner" style="{{adaptiveSectionStyle}}">
          <text class="section-title" style="{{sectionTitleStyle}}">词性对照</text>
          <text class="desc-line" style="{{descLineStyle}}" for="{{ line in posLines }}">{{ line }}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import {appScreenClass, currentScreenClass} from "../../common/screenColumn"
import router from "@system.router"
import {applyKeepScreenOnSetting} from "../../common/keepScreenOn"
import app from "@system.app"

const {navGuard} = global

// 静态文案放在模块作用域：高度在 onInit 一次算完，文本节点按需补齐
const LICENSE_ITEMS = ["ECDICT（MIT）", "CC-CEDICT", "BNC/COCA 词族表", "Q群：1077276609"]

const USAGE_ITEMS = [
  "1. 查词：输入英文或中文，支持词形变化检索",
  "2. 大号输入：连点 3 次搜索框，切换大号键盘",
  "3. 结果卡片：点击查看完整释义",
  "4. 详情页：收藏词条，上限 150 条，可追踪词链",
  "5. 收藏管理：字母筛选、分页浏览",
  "6. 历史记录：自动缓存最近 20 条",
  "7. 变形查询：首页「变形」按钮查询单词变形",
  "8. 快速返回：结果列表页长按返回键回主页",
  "9. 设置：可切换首页布局、按钮缩放、屏幕常亮"
]

const LIMIT_ITEMS = [
  "• 约 1.5 万英文词、12.2 万中文词组",
  "• 每次最多显示 20 条，模糊候选最多 80 条",
  "• 收藏上限 150 条，历史缓存 20 条",
  "• 中文支持词组和单字检索，长句可能缺失",
  "• 数据完全离线，首次读取分片时请稍候"
]

const TAG_ITEMS = [
  "zk  中考词汇",
  "gk  高考词汇",
  "cet4  大学英语四级",
  "cet6  大学英语六级",
  "ky  考研词汇",
  "toefl  托福",
  "ielts  雅思",
  "gre  GRE"
]

const POS_ITEMS = [
  "n.  名词",
  "v.  动词：vt. 及物 / vi. 不及物",
  "a.  形容词",
  "adv.  副词",
  "pron.  代词",
  "prep.  介词",
  "conj.  连词",
  "interj.  感叹词",
  "num.  数词"
]

const SECTION_ITEMS = {
  usage: USAGE_ITEMS,
  limits: LIMIT_ITEMS,
  tags: TAG_ITEMS,
  pos: POS_ITEMS
}

// 首屏之外的段落：onShow 之后逐帧填空，滑动时兜底一次性补齐
const DEFERRED_SECTIONS = ["usage", "limits", "tags", "pos"]

export default {
  private: {
    screenClass: currentScreenClass(),
    versionName: "",
    touchStartX: -1,
    touchStartY: -1,
    layoutWidth: 196,
    textWidth: 180,
    usageHeight: 420,
    licenseHeight: 110,
    limitsHeight: 340,
    tagsHeight: 320,
    posHeight: 380,
    usageLines: [],
    licenseLines: [],
    limitLines: [],
    tagLines: [],
    posLines: [],
    adaptiveSectionStyle: "width: 196px; align-items: center;",
    sectionTitleStyle: "width: 180px; text-align: left;",
    devLineStyle: "width: 180px; text-align: center;",
    descLineStyle: "width: 180px; text-align: left;",
    layoutKeyCache: "",
    allFilled: false,
    fillTimer: null
  },

  onInit() {
    this.versionName = this._readVersionName()
    this.applyScreenLayout()
  },

  _readVersionName() {
    const fallback = "3.2.0"
    try {
      const info = app.getInfo()
      if (info && info.versionName) {
        return String(info.versionName)
      }
    } catch (e) {
      // 旧平台不支持 getInfo 时退回编译期写死的值
    }
    return fallback
  },

  onShow() {


    this.screenClass = appScreenClass(this)
    this.refreshLayoutIfNeeded()
    applyKeepScreenOnSetting()
    this.scheduleDeferredSections()
  },

  onDestroy() {
    if (this.fillTimer) {
      clearTimeout(this.fillTimer)
      this.fillTimer = null
    }
  },

  applyScreenLayout() {
    const appData = this.$app.$def.data || {}
    const sw = appData.screenWidth || 212
    const profile = appData.screenProfile || "pill-standard"
    const isPill = profile === "pill-standard" || profile === "pill-compact"
    const safeWidth = sw === 466 ? Math.round(sw / Math.SQRT2) : sw - 20
    this.layoutKeyCache = sw + "|" + profile

    if (isPill) {
      this.layoutWidth = 196
      this.textWidth = 180
      this.adaptiveSectionStyle = "width: 196px; align-items: center;"
      this.sectionTitleStyle = "width: 180px; text-align: left;"
      this.devLineStyle = "width: 180px; text-align: center;"
      this.descLineStyle = "width: 180px; text-align: left;"
    } else {
      this.layoutWidth = safeWidth
      this.textWidth = Math.max(180, safeWidth - 16)
      this.adaptiveSectionStyle = "width: " + safeWidth + "px; align-items: flex-start;"
      this.sectionTitleStyle = "width: " + this.textWidth + "px; text-align: left;"
      this.devLineStyle = "width: " + this.textWidth + "px; text-align: left;"
      this.descLineStyle = "width: " + this.textWidth + "px; text-align: left;"
    }

    const usageLines = this.wrapSectionLines(USAGE_ITEMS, this.textWidth)
    const limitLines = this.wrapSectionLines(LIMIT_ITEMS, this.textWidth)
    const tagLines = this.wrapSectionLines(TAG_ITEMS, this.textWidth)
    const posLines = this.wrapSectionLines(POS_ITEMS, this.textWidth)

    // 首屏只有致谢卡片 + Developers；其余 4 段先算高度占位，文本节点 show 之后再补
    this.licenseLines = this.wrapSectionLines(LICENSE_ITEMS, this.textWidth)
    this.usageLines = []
    this.limitLines = []
    this.tagLines = []
    this.posLines = []

    this.usageHeight = this.sectionHeight(usageLines, 260)
    this.licenseHeight = this.sectionHeight(this.licenseLines, 110)
    this.limitsHeight = this.sectionHeight(limitLines, 260)
    this.tagsHeight = this.sectionHeight(tagLines, 260)
    this.posHeight = this.sectionHeight(posLines, 320)
  },

  refreshLayoutIfNeeded() {
    const appData = this.$app.$def.data || {}
    const sw = appData.screenWidth || 212
    const profile = appData.screenProfile || "pill-standard"
    if (sw + "|" + profile === this.layoutKeyCache) {
      return
    }
    this.allFilled = false
    this.applyScreenLayout()
    this.scheduleDeferredSections()
  },

  scheduleDeferredSections() {
    if (this.allFilled || this.fillTimer) {
      return
    }

    let index = 0
    const step = () => {
      this.fillTimer = null
      if (index >= DEFERRED_SECTIONS.length) {
        this.allFilled = true
        return
      }
      this.fillSection(DEFERRED_SECTIONS[index])
      index++
      this.fillTimer = setTimeout(step, 16)
    }
    this.fillTimer = setTimeout(step, 0)
  },

  fillSection(key) {
    const lines = this.wrapSectionLines(SECTION_ITEMS[key], this.textWidth)
    if (key === "usage") {
      this.usageLines = lines
    } else if (key === "limits") {
      this.limitLines = lines
    } else if (key === "tags") {
      this.tagLines = lines
    } else if (key === "pos") {
      this.posLines = lines
    }
  },

  fillAllSections() {
    if (this.allFilled) {
      return
    }
    this.allFilled = true
    if (this.fillTimer) {
      clearTimeout(this.fillTimer)
      this.fillTimer = null
    }
    for (let i = 0; i < DEFERRED_SECTIONS.length; i++) {
      this.fillSection(DEFERRED_SECTIONS[i])
    }
  },

  onListScroll() {
    // 兜底：用户滑到还没填的段落时立刻补齐，避免空白
    if (!this.allFilled) {
      this.fillAllSections()
    }
  },

  wrapSectionLines(items, maxWidth) {
    const lines = []
    for (let i = 0; i < items.length; i++) {
      const wrapped = this.wrapText(items[i], maxWidth)
      for (let j = 0; j < wrapped.length; j++) {
        lines.push(wrapped[j])
      }
    }
    return lines
  },

  sectionHeight(lines, minimum) {
    return Math.max(minimum, 58 + lines.length * 28)
  },

  wrapText(value, maxWidth) {
    const text = (value || "").trim()
    if (!text) {
      return []
    }

    const lines = []
    let line = ""
    let width = 0
    let lastBreak = -1
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      const chWidth = ch >= "A" && ch <= "z" ? 10 : 18
      if (line && width + chWidth > maxWidth) {
        if (lastBreak > 0) {
          lines.push(line.slice(0, lastBreak).trim())
          line = line.slice(lastBreak).trim()
          width = this.measureTextWidth(line)
        } else {
          lines.push(line)
          line = ""
          width = 0
        }
        lastBreak = -1
      }
      line += ch
      width += chWidth
      if (ch === "：" || ch === "，" || ch === "、" || ch === "。") {
        lastBreak = line.length
      }
    }
    if (line) {
      lines.push(line)
    }
    return lines
  },

  measureTextWidth(value) {
    let width = 0
    for (let i = 0; i < value.length; i++) {
      const ch = value.charAt(i)
      width += ch >= "A" && ch <= "z" ? 10 : 18
    }
    return width
  },

  goBack() {
    if (!navGuard()) {
      return
    }
    router.back()
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const sw = this.$app.$def.data.screenWidth || 212
    const startsInLeftQuarter = this.touchStartX <= sw * 0.1
    const endsAtRightQuarter = endX >= sw * 0.85
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 60

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>

.back-btn {
  width: 102px;
  height: 72px;
}

