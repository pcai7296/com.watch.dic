  width: 180px;
  height: 38px;
  margin-top: 14px;
  color: #aeb0b4;
  font-size: 26px;
  font-weight: 700;
  text-align: left;
}

.dev-role {
  width: 180px;
  height: 26px;
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
  text-align: center;
}

.dev-name {
  width: 180px;
  height: 28px;
  color: #ffffff;
  font-size: 18px;
  text-align: center;
}

.license-line {
  width: 180px;
  height: 24px;
  color: #ffffff;
  font-size: 18px;
  text-align: center;
}

.desc-line {
  width: 180px;
  height: auto;
  margin-top: 6px;
  color: #ffffff;
  font-size: 18px;
  text-align: left;
}

.page-432 {
  width: 100%;
  height: 100%;
  padding-top: 8px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.page-466 {
  width: 466px;
  height: 466px;
  padding-top: 0;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.about-list-466 {
  width: 196px;
  height: 385px;
}

.app-card-336 {
  width: 311px;
  height: 240px;
  padding-left: 18px;
  padding-top: 24px;
  border-radius: 30px;
  background-color: #242424;
  flex-direction: column;
  position: relative;
}

.app-card-432 {
  width: 417px;
  height: 240px;
  padding-left: 18px;
  padding-top: 24px;
  border-radius: 30px;
  background-color: #242424;
  flex-direction: column;
  position: relative;
}

.app-card-466 {
  width: 305px;
  height: 240px;
  padding-left: 18px;
