<template>
  <div class="guide-page" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <text class="guide-eyebrow guide-eyebrow-{{screenClass}}">腕上词典</text>
    <div class="guide-title-box guide-title-box-{{screenClass}}">
      <text if="{{twoLineTitle}}" class="guide-title guide-title-{{screenClass}}">第一次</text>
      <text if="{{twoLineTitle}}" class="guide-title guide-title-{{screenClass}}">使用？</text>
      <text if="{{!twoLineTitle}}" class="guide-title guide-title-single guide-title-{{screenClass}}">第一次使用？</text>
    </div>

    <div class="guide-qr-card guide-qr-card-{{screenClass}}">
      <qrcode
        class="guide-qr guide-qr-{{screenClass}}"
        value="https://qm.qq.com/q/qDKLtzDX22"
      ></qrcode>
    </div>
    <text class="guide-hint guide-hint-{{screenClass}}">欢迎入群交流。</text>

    <div class="guide-spacer"></div>

    <div
      class="guide-start guide-start-{{screenClass}} {{pressed ? 'guide-start-press' : ''}}"
      onclick="startReading"
      ontouchstart="onStartDown"
      ontouchend="onStartUp"
    >
      <text class="guide-start-text guide-start-text-{{screenClass}}">开始</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import {appScreenClass, currentScreenClass} from "../../common/screenColumn"

const {navGuard} = global

function isTwoLineTitle(cls) {
  return cls === "192" || cls === "212" || cls === "466"
}

export default {
  private: {
    screenClass: currentScreenClass(),
    twoLineTitle: isTwoLineTitle(currentScreenClass()),
    pressed: false,
    touchStartX: -1,
    touchStartY: -1
  },

  onInit() {
    this.screenClass = appScreenClass(this)
    this.twoLineTitle = isTwoLineTitle(this.screenClass)
  },

  onShow() {
    this.screenClass = appScreenClass(this)
    this.twoLineTitle = isTwoLineTitle(this.screenClass)
  },

  onDestroy() {
    if (this._goTimer) {
      clearTimeout(this._goTimer)
      this._goTimer = null
    }
  },

  onStartDown() {
    this.pressed = true
  },

  onStartUp() {
    this.pressed = false
  },

  startReading() {
    if (!navGuard()) {
      return
    }
    prompt.showToast({ message: "请认真阅读使用说明", duration: 2000 })
    // 等 toast 露脸再换页：真机上切页瞬间发起的 toast 会被吞掉
    var self = this
    if (this._goTimer) {
      clearTimeout(this._goTimer)
    }
    this._goTimer = setTimeout(function() {
      self._goTimer = null
      router.replace({ uri: "/pages/about" })
    }, 700)
  },

  onTouchStart(evt) {
    var point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    var point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }
    var endX = point.clientX
    var endY = point.clientY
    var screenWidth = this.$app.$def.data.screenWidth || 212
    var horizontal = Math.abs(endY - this.touchStartY) <= 120
    if (this.touchStartX <= screenWidth * 0.25 && endX >= screenWidth * 0.75 && horizontal) {
      router.back()
    }
    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

