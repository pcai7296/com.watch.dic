<template>
  <div class="page" ontouchstart="onPageTouchStart" ontouchend="onPageTouchEnd">
    <text class="time-text">{{ tc0 }}{{ tc1 }}{{ tc2 }}{{ tc3 }}{{ tc4 }}</text>

    <div class="icon-card">
      <img class="logo-icon" src="/common/logo.png" />
    </div>

    <text class="title">腕上词典</text>
    <text class="subtitle">抬手即查</text>

    <div id="btn-search" class="main-btn {{ pressedKey === 'search' ? 'press-in' : '' }} {{ releasingKey === 'search' ? 'press-out' : '' }}" @click="goSearch" ontouchstart="onBtnDown('search')" ontouchend="onBtnUp('search')">
      <img class="main-btn-icon" src="/common/icons/language.png" />
      <text class="main-btn-label">查单词</text>
    </div>

    <div class="grid">
      <div id="btn-inflect" class="grid-btn {{ pressedKey === 'inflect' ? 'press-in' : '' }} {{ releasingKey === 'inflect' ? 'press-out' : '' }}" @click="goInflectSearch" ontouchstart="onBtnDown('inflect')" ontouchend="onBtnUp('inflect')">
        <img class="grid-btn-icon" src="/common/icons/btn_transform_blue.png" />
        <text class="grid-btn-label">变形</text>
      </div>
      <div id="btn-settings" class="grid-btn {{ pressedKey === 'settings' ? 'press-in' : '' }} {{ releasingKey === 'settings' ? 'press-out' : '' }}" @click="goSettings" ontouchstart="onBtnDown('settings')" ontouchend="onBtnUp('settings')">
        <img class="grid-btn-icon" src="/common/icons/settings-2.png" />
        <text class="grid-btn-label">设置</text>
      </div>
      <div id="btn-history" class="grid-btn {{ pressedKey === 'history' ? 'press-in' : '' }} {{ releasingKey === 'history' ? 'press-out' : '' }}" @click="goHistory" ontouchstart="onBtnDown('history')" ontouchend="onBtnUp('history')">
        <img class="grid-btn-icon" src="/common/icons/history.png" />
        <text class="grid-btn-label">历史</text>
      </div>
      <div id="btn-favorites" class="grid-btn {{ pressedKey === 'favorites' ? 'press-in' : '' }} {{ releasingKey === 'favorites' ? 'press-out' : '' }}" @click="goFavorites" ontouchstart="onBtnDown('favorites')" ontouchend="onBtnUp('favorites')">
        <img class="grid-btn-icon" src="/common/icons/star-gradient.png" />
        <text class="grid-btn-label">收藏</text>
      </div>
    </div>

    <div class="bottom-row">
      <div id="btn-about" class="circle-btn about-btn {{ pressedKey === 'about' ? 'press-in' : '' }} {{ releasingKey === 'about' ? 'press-out' : '' }}" @click="goAbout" ontouchstart="onBtnDown('about')" ontouchend="onBtnUp('about')">
        <img class="circle-icon" src="/common/icons/btn_info_i.png" />
      </div>
      <div id="btn-sponsor" class="circle-btn sponsor-btn {{ pressedKey === 'sponsor' ? 'press-in' : '' }} {{ releasingKey === 'sponsor' ? 'press-out' : '' }}" @click="goSponsor" ontouchstart="onBtnDown('sponsor')" ontouchend="onBtnUp('sponsor')">
        <img class="circle-icon" src="/common/icons/btn_heart_gold.png" />
      </div>
    </div>
  </div>
</template>

<script>
import storage from "@system.storage"
import router from "@system.router"
import app from "@system.app"
import {applyKeepScreenOnSetting} from "../../common/keepScreenOn"

const {buildTarget, navGuard} = global

export default {
  onBackPress() {
    // 兜底：个别设备根页面返回不退出时主动退出；这里不 return true，
    // 让系统默认逻辑（根页面返回 = 退出应用）也生效，避免事件被吃掉后无响应
    app.terminate()
  },

  onPageTouchStart(evt) {
    var point = this.getTouchPoint(evt)
    if (!point) {
      this._pageSwipeX = -1
      this._pageSwipeY = -1
      return
    }
    this._pageSwipeX = point.clientX
    this._pageSwipeY = point.clientY
  },

  onPageTouchEnd(evt) {
    var point = this.getTouchPoint(evt)
    var startX = this._pageSwipeX
    var startY = this._pageSwipeY
    this._pageSwipeX = -1
    this._pageSwipeY = -1
    if (!point || startX < 0) {
      return
    }
    // 部分设备（如小米手环9）不会把根页面的侧滑手势交给 onBackPress，
    // 这里自行识别「左缘起手、右移过半、基本水平」的滑动并退出应用
    var mostlyHorizontal = Math.abs(point.clientY - startY) <= buildTarget.height * 0.25
    if (startX <= buildTarget.width * 0.25 && point.clientX >= buildTarget.width * 0.75 && mostlyHorizontal) {
      app.terminate()
    }
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  },

  private: {
    screenProfile: buildTarget.profile,
    tc0: "",
    tc1: "",
    tc2: "",
    tc3: "",
    tc4: "",
    pressedKey: "",
    releasingKey: "",
    btnScaleEnabled: false
  },

  onInit() {
    this.screenProfile = buildTarget.profile
    this._updateTime()
    this._trackLaunch()
  },

  // 首帧之后再推赞助页：冷启动瞬间再建一个页面会叠加解码/节点峰值
  _scheduleSponsorPrompt() {
    var self = this
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
    }
    this._sponsorTimer = setTimeout(function() {
      self._sponsorTimer = null
      self.goSponsor()
    }, 1500)
  },

  // 非关键的 storage 读取延后到首帧之后，避开与页面创建/图片解码抢峰值
  _scheduleStartupTasks() {
    var self = this
    if (!this._btnScaleTimer) {
      this._btnScaleTimer = setTimeout(function() {
        self._btnScaleTimer = null
        self._loadBtnScale()
      }, 300)
    }
    if (!this._historyCleanDone && !this._historyCleanTimer) {
      this._historyCleanTimer = setTimeout(function() {
        self._historyCleanTimer = null
        self._historyCleanDone = true
        self._cleanInvalidHistory()
      }, 4000)
    }
  },

  onBtnDown(key) {
    if (!this.btnScaleEnabled) {
      return
    }
    this.pressedKey = key
    this.releasingKey = ""
    this._pressStart = Date.now()
    this._longPress = false
  },

  onBtnUp(key) {
    if (!this.btnScaleEnabled) {
      return
    }
    if (Date.now() - this._pressStart >= 200) {
      this._longPress = true
    }
    this.pressedKey = ""
    this.releasingKey = key
    var self = this
    if (this._btnUpTimer) {
      clearTimeout(this._btnUpTimer)
    }
    this._btnUpTimer = setTimeout(function() {
      self._btnUpTimer = null
      if (self.releasingKey === key) {
        self.releasingKey = ""
      }
    }, 200)
  },

  _loadBtnScale() {
    storage.get({
      key: "dic_button_scale",
      default: "1",
      success: (data) => {
        const value = data && (data.value || data)
        this.btnScaleEnabled = value === "1"
      },
      fail: (data, code) => {
        console.log("index btn scale get failed: " + code)
      },
      complete: () => {}
    })
  },

  onShow() {
    this._updateTime()
    this._startTimeTicker()
    applyKeepScreenOnSetting()
    this._scheduleStartupTasks()
  },

  onHide() {
    this._stopTimeTicker()
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
      this._sponsorTimer = null
    }
  },

  onDestroy() {
    if (this._btnUpTimer) {
      clearTimeout(this._btnUpTimer)
      this._btnUpTimer = null
    }
    if (this._btnScaleTimer) {
      clearTimeout(this._btnScaleTimer)
      this._btnScaleTimer = null
    }
    if (this._historyCleanTimer) {
      clearTimeout(this._historyCleanTimer)
      this._historyCleanTimer = null
    }
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
      this._sponsorTimer = null
    }
    this._stopTimeTicker()
  },

  _updateTime() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    var t = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m
    if (this.tc0 !== t[0]) this.tc0 = t[0]
    if (this.tc1 !== t[1]) this.tc1 = t[1]
    if (this.tc2 !== t[2]) this.tc2 = t[2]
    if (this.tc3 !== t[3]) this.tc3 = t[3]
    if (this.tc4 !== t[4]) this.tc4 = t[4]
  },

  _startTimeTicker() {
    this._stopTimeTicker()
    this._scheduleNextTick()
  },

  _scheduleNextTick() {
    var self = this
    var delay = 60000 - (Date.now() % 60000)
    this._timeTimer = setTimeout(function() {
      self._timeTimer = null
      self._updateTime()
      self._scheduleNextTick()
    }, delay)
  },

  _stopTimeTicker() {
    if (this._timeTimer) {
      clearTimeout(this._timeTimer)
      this._timeTimer = null
    }
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: (data) => {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: (setData, code) => {
            console.log("index launch count save failed: " + code)
          },
          complete: () => {}
        })
        if (nextCount === 1 || nextCount % 10 === 0) {
          this._scheduleSponsorPrompt()
        }
      },
      fail: (getData, code) => {
        console.log("index launch count read failed: " + code)
      },
      complete: () => {}
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return

        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }

        if (clean.length < list.length) {
          storage.set({
            key: "dic_history",
            value: JSON.stringify(clean),
            complete: function() {}
          })
        }
      },
      fail: function() {},
      complete: function() {}
    })
  },

  goInflectSearch() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/search",
      params: {
        searchMode: "inflect",
        inflectDepth: "0"
      }
    })
  },

  goSearch() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/search"
    })
  },

  goSettings() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/settings"
    })
  },

  goHistory() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/records",
      params: {
        type: "history"
      }
    })
  },

  goFavorites() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/records",
      params: {
        type: "favorites"
      }
    })
  },

  goAbout() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/about"
    })
  },

  goSponsor() {
    if (this._longPress || !navGuard()) return
    router.push({
      uri: "/pages/sponsor"
    })
  }
}
</script>

<style>
.page {
  width: 432px;
  height: 514px;
  background-color: #020813;
  flex-direction: column;
  align-items: center;
}

.time-text {
  width: 116px;
  height: 30px;
  margin-top: 4px;
  margin-bottom: 6px;
  font-size: 25px;
  font-weight: 600;
  font-family: monospace;
  color: #ffffff;
  text-align: center;
}

.icon-card {
  width: 108px;
  height: 90px;
  margin-bottom: 9px;
  justify-content: center;
  align-items: center;
}

.logo-icon {
  width: 93px;
  height: 77px;
}

.title {
  width: 206px;
  height: 32px;
  font-size: 30px;
  font-weight: 800;
  color: #ffffff;
  text-align: center;
  margin-bottom: 2px;
}

.subtitle {
  width: 154px;
  height: 24px;
  font-size: 21px;
  font-weight: 400;
  color: #6888b8;
  text-align: center;
  margin-bottom: 11px;
}

.main-btn {
  width: 391px;
  height: 75px;
  border-radius: 19px;
  border-width: 1.5px;
  border-color: #4a6a8a;
  background-color: #3a6898;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 13px;
}

.main-btn-icon {
  width: 63px;
  height: 52px;
  margin-right: 17px;
}

.main-btn-label {
  font-size: 33px;
  font-weight: 800;
  color: #ffffff;
}

.grid {
  width: 391px;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 11px;
}

.grid-btn {
  width: 180px;
  height: 71px;
  border-radius: 17px;
  border-width: 1.5px;
  border-color: rgba(104, 136, 184, 0.25);
  background-color: #081520;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.grid-btn-icon {
  width: 36px;
  height: 30px;
  margin-bottom: 2px;
}

.grid-btn-label {
  font-size: 18px;
  font-weight: 700;
  color: #c0d0e8;
}

.bottom-row {
  width: 129px;
  height: 51px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.circle-btn {
  width: 62px;
  height: 51px;
  border-radius: 29px;
  justify-content: center;
  align-items: center;
}

.about-btn {
  background-color: #14181e;
  border-width: 1px;
  border-color: #1a2a40;
}

.sponsor-btn {
  background-color: #14181e;
  border-width: 1px;
  border-color: #1a2a40;
}

.circle-icon {
  width: 31px;
  height: 26px;
}

/* Vela CSS 不支持 @keyframes（日志报 Unknown style - keyframes），按压反馈改用 transition。
   与 w212/src/pages/index/index.ux 的参考实现一致：120ms ease-out，按下 scale(0.85)。 */
.press-in {
  transform: scale(0.85);
  transition: transform 120ms ease-out;
  transform-origin: 50% 50%;
}

.press-out {
  transform: scale(1);
  transition: transform 120ms ease-out;
  transform-origin: 50% 50%;
}
</style>