<template>
  <div class="page page-{{screenClass}}" ontouchstart="onPageTouchStart" ontouchend="onPageTouchEnd">
    <!-- 共用：时间（弧形） -->
    <div class="clock clock-{{screenClass}}">
      <text style="position:absolute;left:53px;top:8.4px;width:20px;font-size:25px;font-weight:600;text-align:center;color:#ffffff;transform:rotate(-21deg);transform-origin:10px 16.5px;">{{tc0}}</text>
      <text style="position:absolute;left:73px;top:2.8px;width:20px;font-size:25px;font-weight:600;text-align:center;color:#ffffff;transform:rotate(-10.3deg);transform-origin:10px 16.5px;">{{tc1}}</text>
      <text style="position:absolute;left:93px;top:1px;width:20px;font-size:25px;font-weight:600;text-align:center;color:#ffffff;">{{tc2}}</text>
      <text style="position:absolute;left:113px;top:2.8px;width:20px;font-size:25px;font-weight:600;text-align:center;color:#ffffff;transform:rotate(10.3deg);transform-origin:10px 16.5px;">{{tc3}}</text>
      <text style="position:absolute;left:133px;top:8.4px;width:20px;font-size:25px;font-weight:600;text-align:center;color:#ffffff;transform:rotate(21deg);transform-origin:10px 16.5px;">{{tc4}}</text>
    </div>

    <!-- ===== 布局一：简约 (minimal) ===== -->
    <div if="{{layoutMode === 'minimal'}}" class="minimal-wrap">
      <text class="title title-{{screenClass}} m-title">腕上词典</text>

      <div class="icon-card icon-card-{{screenClass}} m-icon-card">
        <img class="deco-icon deco-icon-{{screenClass}}" src="/common/logo.png" />
      </div>

      <div class="minimal-btns">
        <div class="m-btn {{ pressedKey === 'search' ? 'press-in' : '' }} {{ releasingKey === 'search' ? 'press-out' : '' }}" onclick="goSearch" ontouchstart="onBtnDown('search')" ontouchend="onBtnUp('search')">
          <image static class="m-btn-icon" src="/common/icons/language.png" />
          <text static class="m-btn-text">查单词</text>
        </div>
        <div class="m-btn m-btn-mt {{ pressedKey === 'history' ? 'press-in' : '' }} {{ releasingKey === 'history' ? 'press-out' : '' }}" onclick="goHistory" ontouchstart="onBtnDown('history')" ontouchend="onBtnUp('history')">
          <image static class="m-btn-icon" src="/common/icons/history.png" />
          <text static class="m-btn-text">历史记录</text>
        </div>
        <div class="m-btn m-btn-mt {{ pressedKey === 'favorites' ? 'press-in' : '' }} {{ releasingKey === 'favorites' ? 'press-out' : '' }}" onclick="goFavorites" ontouchstart="onBtnDown('favorites')" ontouchend="onBtnUp('favorites')">
          <image static class="m-btn-icon" src="/common/icons/star-gradient.png" />
          <text static class="m-btn-text">我的收藏</text>
        </div>
        <div class="m-btn m-btn-mt {{ pressedKey === 'settings' ? 'press-in' : '' }} {{ releasingKey === 'settings' ? 'press-out' : '' }}" onclick="goSettings" ontouchstart="onBtnDown('settings')" ontouchend="onBtnUp('settings')">
          <image static class="m-btn-icon" src="/common/icons/settings-2.png" />
          <text static class="m-btn-text">设置</text>
        </div>
      </div>

      <div class="m-bottom">
        <div class="m-circle {{ pressedKey === 'about' ? 'press-in' : '' }} {{ releasingKey === 'about' ? 'press-out' : '' }}" onclick="goAbout" ontouchstart="onBtnDown('about')" ontouchend="onBtnUp('about')">
          <image static class="m-circle-icon m-circle-icon-{{screenClass}}" src="/common/icons/btn_info_i.png" />
        </div>
        <div class="m-circle m-circle-ml {{ pressedKey === 'sponsor' ? 'press-in' : '' }} {{ releasingKey === 'sponsor' ? 'press-out' : '' }}" onclick="goSponsor" ontouchstart="onBtnDown('sponsor')" ontouchend="onBtnUp('sponsor')">
          <image static class="m-circle-icon m-circle-icon-{{screenClass}}" src="/common/icons/btn_heart_gold.png" />
        </div>
      </div>
    </div>

    <!-- ===== 布局二：经典 (classic) ===== -->
    <div if="{{layoutMode === 'classic'}}" class="classic-wrap">
      <div class="icon-card icon-card-{{screenClass}} c-icon-card">
        <img class="deco-icon deco-icon-{{screenClass}}" src="/common/logo.png" />
      </div>

      <text class="title title-{{screenClass}} c-title">腕上词典</text>
      <text class="subtitle subtitle-{{screenClass}}">抬手即查</text>

      <div class="main-button main-button-{{screenClass}} secondary-button c-main-btn {{ pressedKey === 'search' ? 'press-in' : '' }} {{ releasingKey === 'search' ? 'press-out' : '' }}" onclick="goSearch" ontouchstart="onBtnDown('search')" ontouchend="onBtnUp('search')">
        <image static class="c-btn-icon c-btn-icon-{{screenClass}}" src="/common/icons/language.png" />
        <text static class="btn-label btn-label-{{screenClass}}">查单词</text>
      </div>

      <div class="button-group button-group-{{screenClass}}">
        <div class="grid-button grid-button-{{screenClass}} {{ pressedKey === 'inflect' ? 'press-in' : '' }} {{ releasingKey === 'inflect' ? 'press-out' : '' }}" onclick="goInflectSearch" ontouchstart="onBtnDown('inflect')" ontouchend="onBtnUp('inflect')">
          <image static class="c-grid-icon c-grid-icon-{{screenClass}}" src="/common/icons/btn_transform_blue.png" />
          <text static class="grid-btn-text grid-btn-text-{{screenClass}}">变形</text>
        </div>
        <div class="grid-button grid-button-{{screenClass}} {{ pressedKey === 'settings' ? 'press-in' : '' }} {{ releasingKey === 'settings' ? 'press-out' : '' }}" onclick="goSettings" ontouchstart="onBtnDown('settings')" ontouchend="onBtnUp('settings')">
          <image static class="c-grid-icon c-grid-icon-{{screenClass}}" src="/common/icons/settings-2.png" />
          <text static class="grid-btn-text grid-btn-text-{{screenClass}}">设置</text>
        </div>
        <div class="grid-button grid-button-{{screenClass}} {{ pressedKey === 'history' ? 'press-in' : '' }} {{ releasingKey === 'history' ? 'press-out' : '' }}" onclick="goHistory" ontouchstart="onBtnDown('history')" ontouchend="onBtnUp('history')">
          <image static class="c-grid-icon c-grid-icon-{{screenClass}}" src="/common/icons/history.png" />
          <text static class="grid-btn-text grid-btn-text-{{screenClass}}">历史</text>
        </div>
        <div class="grid-button grid-button-{{screenClass}} {{ pressedKey === 'favorites' ? 'press-in' : '' }} {{ releasingKey === 'favorites' ? 'press-out' : '' }}" onclick="goFavorites" ontouchstart="onBtnDown('favorites')" ontouchend="onBtnUp('favorites')">
          <image static class="c-grid-icon c-grid-icon-{{screenClass}}" src="/common/icons/star-gradient.png" />
          <text static class="grid-btn-text grid-btn-text-{{screenClass}}">收藏</text>
        </div>
      </div>

      <div class="bottom-row bottom-row-{{screenClass}}">
        <div class="m-circle {{ pressedKey === 'about' ? 'press-in' : '' }} {{ releasingKey === 'about' ? 'press-out' : '' }}" onclick="goAbout" ontouchstart="onBtnDown('about')" ontouchend="onBtnUp('about')">
          <image static class="m-circle-icon m-circle-icon-{{screenClass}}" src="/common/icons/btn_info_i.png" />
        </div>
        <div class="m-circle m-circle-ml {{ pressedKey === 'sponsor' ? 'press-in' : '' }} {{ releasingKey === 'sponsor' ? 'press-out' : '' }}" onclick="goSponsor" ontouchstart="onBtnDown('sponsor')" ontouchend="onBtnUp('sponsor')">
          <image static class="m-circle-icon m-circle-icon-{{screenClass}}" src="/common/icons/btn_heart_gold.png" />
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import {appScreenClass, currentScreenClass, supportsMinimalLayout} from "../../common/screenColumn"
import storage from "@system.storage"
import router from "@system.router"
import app from "@system.app"
import {applyKeepScreenOnSetting} from "../../common/keepScreenOn"

const {buildTarget, navGuard} = global

export default {
  onBackPress() {
    // 兜底：个别设备根页面返回不退出时主动退出；这里不 return true，
    // 让系统默认逻辑（根页面返回 = 退出应用）也生效，避免事件被吃掉后无响应
    app.terminate()
  },

  onPageTouchStart(evt) {
    var point = this.getTouchPoint(evt)
    if (!point) {
      this._pageSwipeX = -1
      this._pageSwipeY = -1
      return
    }
    this._pageSwipeX = point.clientX
    this._pageSwipeY = point.clientY
  },

  onPageTouchEnd(evt) {
    var point = this.getTouchPoint(evt)
    var startX = this._pageSwipeX
    var startY = this._pageSwipeY
    this._pageSwipeX = -1
    this._pageSwipeY = -1
    if (!point || startX < 0) {
      return
    }
    // 部分设备（如小米手环9）不会把根页面的侧滑手势交给 onBackPress，
    // 这里自行识别「左缘起手、右移过半、基本水平」的滑动并退出应用
    var mostlyHorizontal = Math.abs(point.clientY - startY) <= buildTarget.height * 0.25
    if (startX <= buildTarget.width * 0.25 && point.clientX >= buildTarget.width * 0.75 && mostlyHorizontal) {
      app.terminate()
    }
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  },

  private: {
    screenClass: currentScreenClass(),
    screenProfile: buildTarget.profile,
    layoutMode: supportsMinimalLayout(currentScreenClass()) ? "minimal" : "classic",
    tc0: "", tc1: "", tc2: "", tc3: "", tc4: "",
    pressedKey: "",
    releasingKey: "",
    btnScaleEnabled: false
  },

  onInit() {
    this.screenProfile = buildTarget.profile
    this._updateTime()
    this._loadLayout()
    this._trackLaunch()
  },

  _updateTime() {
    var now = new Date()
    var h = now.getHours()
    var m = now.getMinutes()
    var t = (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m
    if (this.tc0 !== t[0]) this.tc0 = t[0]
    if (this.tc1 !== t[1]) this.tc1 = t[1]
    if (this.tc2 !== t[2]) this.tc2 = t[2]
    if (this.tc3 !== t[3]) this.tc3 = t[3]
    if (this.tc4 !== t[4]) this.tc4 = t[4]
  },

  _startTimeTicker() {
    this._stopTimeTicker()
    this._scheduleNextTick()
  },

  _scheduleNextTick() {
    var self = this
    var delay = 60000 - (Date.now() % 60000)
    this._timeTimer = setTimeout(function() {
      self._timeTimer = null
      self._updateTime()
      self._scheduleNextTick()
    }, delay)
  },

  _stopTimeTicker() {
    if (this._timeTimer) {
      clearTimeout(this._timeTimer)
      this._timeTimer = null
    }
  },

  _loadLayout() {
    var self = this
    storage.get({
      key: "dic_home_layout",
      default: "minimal",
      success: function(data) {
        var value = data && (data.value || data)
        if (value === "classic" || value === "minimal") {
          // 简约布局只有胶囊屏（192/212）有设计稿，其余列强制经典
          self.layoutMode = supportsMinimalLayout(self.screenClass) ? value : "classic"
        }
      },
      fail: function() {},
      complete: function() {}
    })
  },

  _trackLaunch() {
    storage.get({
      key: "dic_launch_count",
      default: "0",
      success: function(data) {
        var raw = data && (data.value || data)
        var count = parseInt(raw, 10)
        if (!isFinite(count) || count < 0) {
          count = 0
        }
        var nextCount = count + 1
        storage.set({
          key: "dic_launch_count",
          value: String(nextCount),
          fail: function(setData, code) {
            console.log("index launch count save failed: " + code)
          },
          complete: function() {}
        })
        if (nextCount === 1 || nextCount % 10 === 0) {
          this._scheduleSponsorPrompt()
        }
      }.bind(this),
      fail: function(getData, code) {
        console.log("index launch count read failed: " + code)
      }.bind(this),
      complete: function() {}
    })
  },

  _cleanInvalidHistory() {
    storage.get({
      key: "dic_history",
      success: function(data) {
        var text = data && (data.value || data)
        if (!text) return
        var list
        try { list = JSON.parse(text) } catch (e) { return }
        if (!list || !list.length) return
        var clean = []
        for (var i = 0; i < list.length; i++) {
          var item = list[i]
          if (item && item.query && item.query.toString().trim() && item.ids && item.ids.length > 0) {
            clean.push(item)
          }
        }
        if (clean.length < list.length) {
          storage.set({ key: "dic_history", value: JSON.stringify(clean), complete: function() {} })
        }
      },
      fail: function() {},
      complete: function() {}
    })
  },

  // 首帧之后再推赞助页：冷启动瞬间再建一个页面会叠加解码/节点峰值
  _scheduleSponsorPrompt() {
    var self = this
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
    }
    this._sponsorTimer = setTimeout(function() {
      self._sponsorTimer = null
      self.goSponsor()
    }, 1500)
  },

  // 非关键的 storage 读取延后到首帧之后，避开与页面创建/图片解码抢峰值
  _scheduleStartupTasks() {
    var self = this
    if (!this._btnScaleTimer) {
      this._btnScaleTimer = setTimeout(function() {
        self._btnScaleTimer = null
        self._loadBtnScale()
      }, 300)
    }
    if (!this._historyCleanDone && !this._historyCleanTimer) {
      this._historyCleanTimer = setTimeout(function() {
        self._historyCleanTimer = null
        self._historyCleanDone = true
        self._cleanInvalidHistory()
      }, 4000)
    }
  },

  onBtnDown(key) {
    if (!this.btnScaleEnabled) {
      return
    }
    this.pressedKey = key
    this.releasingKey = ""
    this._pressStart = Date.now()
    this._longPress = false
  },

  onBtnUp(key) {
    if (!this.btnScaleEnabled) {
      return
    }
    if (Date.now() - this._pressStart >= 200) {
      this._longPress = true
    }
    this.pressedKey = ""
    this.releasingKey = key
    var self = this
    if (this._btnUpTimer) {
      clearTimeout(this._btnUpTimer)
    }
    this._btnUpTimer = setTimeout(function() {
      self._btnUpTimer = null
      if (self.releasingKey === key) {
        self.releasingKey = ""
      }
    }, 200)
  },

  _loadBtnScale() {
    var self = this
    storage.get({
      key: "dic_button_scale",
      default: "1",
      success: function(data) {
        var value = data && (data.value || data)
        self.btnScaleEnabled = value === "1"
      },
      fail: function() {},
      complete: function() {}
    })
  },

  onShow() {


    this.screenClass = appScreenClass(this)
    // 矩形屏/圆屏没有简约布局的设计稿，切列后立即回落到经典
    if (!supportsMinimalLayout(this.screenClass)) {
      this.layoutMode = "classic"
    }
    this._updateTime()
    this._startTimeTicker()
    applyKeepScreenOnSetting()
    this._scheduleStartupTasks()
  },

  onHide() {
    this._stopTimeTicker()
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
      this._sponsorTimer = null
    }
  },

  onDestroy() {
    if (this._btnUpTimer) {
      clearTimeout(this._btnUpTimer)
      this._btnUpTimer = null
    }
    if (this._historyCleanTimer) {
      clearTimeout(this._historyCleanTimer)
      this._historyCleanTimer = null
    }
    if (this._btnScaleTimer) {
      clearTimeout(this._btnScaleTimer)
      this._btnScaleTimer = null
    }
    if (this._sponsorTimer) {
      clearTimeout(this._sponsorTimer)
      this._sponsorTimer = null
    }
    this._stopTimeTicker()
  },

  goInflectSearch() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/search", params: { searchMode: "inflect", inflectDepth: "0" } })
  },
  goSearch() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/search" })
  },
  goSettings() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/settings" })
  },
  goHistory() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/records", params: { type: "history" } })
  },
  goFavorites() {
    if (this._longPress || !navGuard()) {
      return
    }
    // 收藏非空时提示加载中：判断后带 loading 参数，由收藏列表页内 toast（真机上
    // 页面切换瞬间发起的 toast 会被吞掉，改为页面稳定后提示）
    storage.get({
      key: "dic_favorites",
      default: "[]",
      success: (data) => {
        const text = data && (data.value || data)
        let hasFavorites = false
        if (text) {
          try {
            const list = JSON.parse(text)
            hasFavorites = !!(list && list.length)
          } catch (e) {
            hasFavorites = false
          }
        }
        router.push({
          uri: "/pages/records",
          params: { type: "favorites", loading: hasFavorites ? "1" : "0" }
        })
      },
      fail: () => {
        router.push({ uri: "/pages/records", params: { type: "favorites", loading: "0" } })
      },
      complete: () => {}
    })
  },
  goAbout() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/about" })
  },
  goSponsor() {
    if (this._longPress || !navGuard()) {
      return
    }
    router.push({ uri: "/pages/sponsor" })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 39px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.time-header {
  width: 212px;
  height: 44px;
  margin-top: 18px;
  margin-bottom: -4px;
  position: relative;
}

.time {
  position: absolute;
  width: 25px;
  height: 33px;
  font-size: 25px;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #7090b0;
  transform-origin: 12.5px 16.5px;
}

.time1 {
  left: 60.9px;
  top: 10.8px;
  transform: rotate(-21deg);
}

.time2 {
  left: 79px;
  top: 6px;
  transform: rotate(-9deg);
}

.time3 {
  left: 93.5px;
  top: 2px;
}

.time4 {
  left: 108px;
  top: 6px;
  transform: rotate(9deg);
}

.time5 {
  left: 126.1px;
  top: 10.8px;
  transform: rotate(21deg);
}

.title {
  width: 160px;
  color: #ffffff;
  font-size: 29px;
  font-weight: 800;
  text-align: center;
}

.icon-card {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 80px;
  height: 80px;
  border-radius: 22px;
  border-width: 0px;
  background-color: transparent;
}

.deco-icon {
  display: flex;
  width: 80px;
  height: 80px;
}

.main-button {
  width: 176px;
  height: 50px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  width: 22px;
  height: 22px;
  margin-left: 14px;
  margin-right: 6px;
}

.btn-label {
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
}

.secondary-button {
  border-width: 1.5px;
  border-color: #4a6a8a;
  background-color: #3a6898;
  color: #ffffff;
  border-radius: 14px;
}

.bottom-row {
  flex-direction: row;
  justify-content: center;
}

.small-button {
  width: 70px;
  height: 42px;
  border-radius: 21px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.btn-icon-sm {
  width: 14px;
  height: 14px;
  margin-right: 4px;
}

.btn-label-sm {
  color: #ffffff;
  font-size: 18px;
  font-weight: 800;
}

.about-button {
  border-width: 2px;
  border-color: #35485f;
  background-color: #161d27;
  color: #ffffff;
}

.sponsor-button {
  border-width: 2px;
  border-color: #d4a017;
  background-color: #1a1408;
  color: #ffffff;
}

.minimal-wrap {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.m-title {
  margin-bottom: 4px;
}

.m-icon-card {
  margin-bottom: 8px;
}

.minimal-btns {
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
}

.m-btn {
  width: 180px;
  height: 52px;
  border-radius: 16px;
  flex-direction: row;
  align-items: center;
  border-width: 1px;
  border-color: #1a2a40;
  background-color: #14181e;
}

.m-btn-mt {
  margin-top: 6px;
}

.m-btn-icon {
  width: 32px;
  height: 32px;
  margin-left: 10px;
  margin-right: 8px;
}

.m-btn-text {
  color: #e0e4ea;
  font-size: 22px;
  font-weight: 700;
}

.m-bottom {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}

.m-circle-ml {
  margin-left: 10px;
}

.m-circle-icon {
  width: 30px;
  height: 30px;
}

