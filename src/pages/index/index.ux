  flex-direction: column;
  align-items: center;
  width: 100%;
}

.c-icon-card {
  margin-bottom: 8px;
}

.c-title {
  margin-bottom: 4px;
}

.subtitle {
  color: #6888b8;
  font-size: 18px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 12px;
}

.c-main-btn {
  margin-bottom: 14px;
}

.c-btn-icon {
  width: 36px;
  height: 36px;
  margin-right: 8px;
}

.c-grid-icon {
  width: 32px;
  height: 32px;
  margin-bottom: 4px;
}

.button-group {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  width: 190px;
}

.grid-button {
