<template>
  <div class="page page-{{screenClass}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <image class="back-btn" src="/common/icons/btn_back.png" onclick="goBack" ontouchstart="onBackButtonTouchStart" ontouchend="onBackButtonTouchEnd" />

    <marquee if="{{ queryMarqueeOn }}" id="query-marquee" class="query-marquee query-marquee-{{screenClass}}"
      scrollamount="{{ queryMarqueeSpeed }}" direction="left" loop="-1" text-offset="40">
      {{ queryText }}   {{ queryText }}
    </marquee>
    <text if="{{ !queryMarqueeOn }}" class="query-text query-text-{{screenClass}}">{{ queryText }}</text>
    <text class="status-text" if="{{ statusText }}">{{ statusText }}</text>

    <list id="result-list" class="result-list" if="{{ resultCards.length > 0 }}" style="width: {{cardWidth}}px;">
      <list-item
        class="result-item"
        type="resultCard"
        for="{{ item in resultCards }}"
        tid="id"
        style="width: {{cardWidth}}px; height: {{ item.itemHeight }}px;"
      >
        <div if="{{ item.recordKind === 'next-page' }}" class="next-button" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="_goToNextPage">
          <text class="next-text">下一页</text>
        </div>
        <div elif="{{ item.recordKind === 'prev-page' }}" class="next-button" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="_goToPrevPage">
          <text class="next-text">上一页</text>
        </div>
        <div else class="result-card" style="width: {{cardWidth}}px; height: {{ item.cardHeight }}px;" @click="openDetail(item)">
          <div class="result-head">
            <text if="{{ !item.wordMarqueeOn }}" class="result-word" style="font-size: {{ item.wordFontSize }}px;">{{ item.word }}</text>
            <marquee if="{{ item.wordMarqueeOn }}" class="result-word-marquee" style="font-size: {{ item.wordFontSize }}px;" scrollamount="40" direction="left" loop="-1" text-offset="40">{{ item.word }}   {{ item.word }}</marquee>
            <text class="result-tag">{{ item.tag }}</text>
          </div>
          <text class="result-phonetic">{{ item.phonetic }}</text>
          <div class="translation-box">
            <text class="result-translation-line" for="{{ line in item.translationLines }}">
              {{ line }}
            </text>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import {appScreenClass, currentScreenClass} from "../../common/screenColumn"
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"
import {decodeDeltaIds, decodePrefixField, parseBase36} from "../../common/dictCodec"
import {getDictionaryProfile, loadDictionaryProfile} from "../../common/dictProfile"
import {applyKeepScreenOnSetting} from "../../common/keepScreenOn"
import {readLines} from "../../common/dictLines"

const {navGuard} = global

const FUZZY_SCAN_LIMIT = 4000
const FUZZY_POOL_LIMIT = 80
const MAX_SAFE_ENTRY_ID = 9007199254740991
const WORD_INDEX_LETTERS = "abcdefghijklmnopqrstuvwxyz"
const MAX_CHINESE_SCAN_SHARDS = 10
// 每次整读 entry 分片前，若 entryCache 已满则先淘汰最旧一片，避免读和写同帧叠加。
// 一片 = 500 条 entry 对象（约 80KB JS 堆）。崩 4 时 free 只剩 48B，
// 任何驻留都要往下压：2 片足够覆盖一次英文搜索的 hydrate 窗口。
const ENTRY_CACHE_SLOTS = 2

// 卡片内存观测用的单价常量。真机没有 native 堆读取接口（panic dump 只给整机
// used/free），所以 [MEMCARD] 日志把「能精确计数」的部分打出来，再按下列单价折算：
//   estJS  来自 11/11 14:16:57 那次 jse_dump_memory_status 的真实统计
//          （memory used 739345B / objects 1488→56.0B / properties 3.4 per object→8.9B
//            / strings 391→37.6B + 字符数据）
//   estNat 每个 JSX 元素（widget + vnode + 属性缓存 + 文本副本）按 250~400B 给区间
const MEM_OBJ_BYTES = 56
const MEM_PROP_BYTES = 9
const MEM_CARD_PROPS = 15
const MEM_STR_BYTES = 38
const MEM_NODE_BYTES_LO = 250
const MEM_NODE_BYTES_HI = 400
// 每张卡固定 7 个节点：list-item / result-card / result-head / word / tag / phonetic / translation-box
const MEM_CARD_FIXED_NODES = 7

class LRUCache {
  constructor(max) {
    this.max = max
    this.cache = {}
    this.order = []
    this.bytes = 0
  }
  size() {
    return this.order.length
  }
  oldest() {
    return this.order.length > 0 ? this.order[0] : undefined
  }
  clear() {
    this.cache = {}
    this.order = []
    this.bytes = 0
  }
  get(key) {
    if (this.cache[key] === undefined) return undefined
    var idx = this.order.indexOf(key)
    if (idx >= 0) {
      this.order.splice(idx, 1)
      this.order.push(key)
    }
    return this.cache[key]
  }
  set(key, val) {
    if (this.cache[key] !== undefined) {
      this.bytes -= this.cache[key].length || 0
      var idx = this.order.indexOf(key)
      if (idx >= 0) this.order.splice(idx, 1)
    }
    this.cache[key] = val
    this.bytes += val.length || 0
    this.order.push(key)
    if (this.order.length > this.max) {
      var oldest = this.order.shift()
      this.bytes -= this.cache[oldest].length || 0
      delete this.cache[oldest]
    }
  }
  delete(key) {
    if (this.cache[key] === undefined) return
    this.bytes -= this.cache[key].length || 0
    delete this.cache[key]
    var idx = this.order.indexOf(key)
    if (idx >= 0) this.order.splice(idx, 1)
  }
}

var TAG_CODE_MAP = {z: 'zk', g: 'gk', '4': 'cet4', '6': 'cet6', k: 'ky', t: 'toefl', i: 'ielts', e: 'gre'}
var TAG_LABELS = ['zk', 'gk', 'cet4', 'cet6', 'ky', 'ielts', 'toefl', 'gre']
var IPA_DECODE_MAP = {
  'a': '\u0259', 'r': '\u025a', 'e': '\u025b',
  'i': '\u026a', "'": '\u02c8', ',': '\u02cc',
  'A': '\u0251', 'U': '\u028a', 'S': '\u0283',
  'Z': '\u0292', 'T': '\u03b8', 'D': '\u00f0',
  'N': '\u014b', 'O': '\u0254', 'E': '\u00e6',
  'R': '\u025c', '|': '\u02d0', 'Q': '\u0252',
  'V': '\u028c', 'g': '\u0261'
}
var PHRASE_DECODE_MAP = {
  '!': 'vt. ', '$': 'vi. ', '@': 'n. ', '#': 'a. ',
  '%': 'ad. ', '^': 'prep. ', '&': 'conj. ', '*': 'pron. ',
  '(': 'int. ', ')': 'num. ', '-': 'art. ', '=': 'aux. ',
  '{': '[计]', '}': '[法]', '|': '[医]', '[': '[生]',
  ']': '[化]', '<': '[物]', '>': '[经]'
}

export default {
  protected: {
    query: "",
    searchMode: "",
    inflectDepth: "",
    phraseMode: "0"
  },

  private: {
    screenClass: currentScreenClass(),
    queryText: "",
    statusText: "",
    resultCards: [],
    searchToken: 0,
    fuzzyWordsChecked: 0,
    lastToastAt: 0,
    toastCooldown: 1500,
    touchStartX: -1,
    touchStartY: -1,
    destroyed: false,
    cardWidth: 0,
    contentWidth: 0,
    screenWidth: 0,
    queryMarqueeOn: false,
    queryMarqueeSpeed: 40,
    flushTimer: null,
    searchPage: 0,
    totalResultCount: 0,
    mightHaveMore: false,
    resultLongPressHomeEnabled: true,
    backLongPressTimer: null,
    backLongPressTriggered: false,
    keepScreenOnApplied: null,
    pageHidden: false
  },

  _expandTag(s) {
    if (!s) return ''
    s = s.replace(/\r/g, '')
    if (s.indexOf(',') < 0 && /^[0-9a-f]+$/.test(s)) {
      var mask = parseInt(s, 16)
      var labels = []
      for (var bit = 0; bit < TAG_LABELS.length; bit++) {
        if (mask & (1 << bit)) {
          labels.push(TAG_LABELS[bit])
        }
      }
      return labels.join(' ')
    }
    return s.split(',').map(function(c) { return TAG_CODE_MAP[c] || c }).filter(Boolean).join(' ')
  },

  _decodeIpa(s) {
    if (!s) return s
    s = s.replace(/\r/g, '')
    var out = ''
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i)
      out += IPA_DECODE_MAP[ch] || ch
    }
    return out
  },

  _decodePhrase(s) {
    if (!s) return s
    s = s.replace(/\r/g, '')
    var out = ''
    for (var i = 0; i < s.length; i++) {
      var ch = s.charAt(i)
      out += PHRASE_DECODE_MAP[ch] || ch
    }
    return out
  },

  onInit() {
    loadDictionaryProfile()
    // 词典分片缓存：纯逻辑数据，不进 viewModel（避免 observer/代理开销）
    this.entryCache = new LRUCache(ENTRY_CACHE_SLOTS)
    this.cnIndexCache = new LRUCache(2)
    this.wrapCache = {}
    this.pendingCards = []
    this.collectedIds = []
    this.historyCache = null
    this.shardIndex = null
    this.loadResultLongPressHomeSetting()
    // Force-reset result state — Vela may reuse page instance without re-init
    this.resultCards = []
    this.statusText = ""
    this.searchToken++
    const sw = this.$app.$def.data.screenWidth || 212
    this.screenWidth = sw
    if (sw === 466) {
      // 圆屏：卡片置于内切正方形内(安全区域)，避免圆角裁切
      this.cardWidth = Math.round(sw / Math.SQRT2) // 330
    } else {
      this.cardWidth = sw - 20
    }
    this.contentWidth = this.cardWidth - 24
    this.queryText = this.normalizeWord(this.query)
    this.applyQueryMarquee(this.queryText)
    this.performSearch()
  },

  onShow() {
    const wasHidden = this.pageHidden

    this.screenClass = appScreenClass(this)
    this.pageHidden = false
    // 回前台先把后台期间残留的垃圾清干净再重绘：崩溃 3 就发生在亮屏后 8 秒，
    // 重建列表时 native 侧要一次性拿到几十 KB 连续空间，提前 GC 是唯一能腾出来的余量。
    if (wasHidden && typeof global !== "undefined" && typeof global.runGC === "function") {
      global.runGC()
    }
    this.loadResultLongPressHomeSetting()
    this.syncKeepScreenOn()
    // Re-check query — Vela may reuse page instance without re-firing onInit
    const currentQuery = this.normalizeWord(this.query)
    if (currentQuery && currentQuery !== this.queryText) {
      this.resultCards = []
      this.statusText = ""
      this.searchToken++
      this.queryText = currentQuery
      this.applyQueryMarquee(currentQuery)
      this.performSearch()
    }
    // 超长单词用 marquee 跑马灯展示全文（list 内嵌 scroll 在 Band 10 上无法接收触摸事件，拖动无效）
    this.logCardMemory("show")
  },

  // 只在偏好真的变了才重新下发 brightness（每次 onShow 无条件下发会在
  // 回前台瞬间和列表重绘撞在同一帧，native 侧要重建属性缓存）
  syncKeepScreenOn() {
    const cached = typeof global !== "undefined" ? global.__keepScreenOn : undefined
    if (cached !== undefined && cached === this.keepScreenOnApplied) {
      return
    }
    const self = this
    applyKeepScreenOnSetting(function (enabled) {
      self.keepScreenOnApplied = enabled
    })
  },

  // 页面转后台：词库分片文本/解析结果全部丢弃，只留 20 张已在屏上的卡片（~8KB）。
  // 崩溃 2 就发生在 background→foreground 后的 5 秒内，后台常驻是主要风险。
  onHide() {
    this.pageHidden = true
    // 转后台前先把这一屏的账记下来：framework 随后会打 jse_dump_memory_status
    //（QuickJS 真实堆），两条日志相邻，可以直接对出卡片 + 缓存的真实占用。
    this.logCardMemory("hide")
    this.entryCache.clear()
    this.cnIndexCache.clear()
    this.wrapCache = {}
    this.historyCache = null
    if (typeof global !== "undefined" && typeof global.runGC === "function") {
      global.runGC()
    }
    this.logCardMemory("hide-done")
  },

  applyQueryMarquee(text) {
    if (text && text.length > 12) {
      this.queryMarqueeOn = true
      const extra = text.length - 12
      this.queryMarqueeSpeed = Math.max(40, Math.min(60, Math.round(40 + extra * 1.5)))
    } else {
      this.queryMarqueeOn = false
      this.queryMarqueeSpeed = 40
    }
  },

  goBack() {
    if (this.backLongPressTriggered || !navGuard()) {
      return
    }
    router.back()
  },

  loadResultLongPressHomeSetting() {
    storage.get({
      key: "dic_result_long_press_home",
      default: "1",
      success: (data) => {
        if (this.destroyed) {
          return
        }
        const value = data && (data.value || data)
        this.resultLongPressHomeEnabled = value !== "0"
      },
      fail: (data, code) => {
        console.log("results long press setting get failed: " + code)
      },
      complete: () => {}
    })
  },

  onBackButtonTouchStart() {
    if (!this.resultLongPressHomeEnabled || this.backLongPressTimer) {
      return
    }
    this.backLongPressTriggered = false
    this.backLongPressTimer = setTimeout(() => {
      this.backLongPressTimer = null
      if (this.destroyed || !this.resultLongPressHomeEnabled || !navGuard()) {
        return
      }
      this.backLongPressTriggered = true
      router.replace({uri: "/pages/index"})
    }, 650)
  },

  onBackButtonTouchEnd() {
    if (this.backLongPressTimer) {
      clearTimeout(this.backLongPressTimer)
      this.backLongPressTimer = null
    }
  },

  openDetail(item) {
    if (!item || !item.word || !navGuard()) {
      return
    }

    router.push({
      uri: "/pages/detail",
      params: {
        word: item.word,
        phonetic: item.rawPhonetic || "",
        translation: item.translation || "",
        tag: item.fullTag || item.rawTag || item.tag || "",
        searchMode: this.searchMode || "",
        inflectDepth: this.inflectDepth || "0"
      }
    })
  },

  performSearch() {
    const normalized = this.normalizeWord(this.queryText)
    this.queryText = normalized

    if (!normalized) {
      this._stopFlushTimer()
      this.resultCards = []
      this.statusText = ""
      this.pendingCards = []
      this.collectedIds = []
      this.totalResultCount = 0
      return
    }

    const token = this.searchToken + 1
    this.searchToken = token
    this.resultCards = []
    this.pendingCards = []
    this.collectedIds = []
    this.totalResultCount = 0
    this.mightHaveMore = false
    this.statusText = "搜索中"
    this._startFlushTimer()

    var self = this
    storage.get({
      key: "dic_history",
      success: function(data) {
        if (token !== self.searchToken) return
        var list = self._parseHistoryList(data)
        // 词组模式不使用历史缓存（历史记录是单词模式的）
        if (self.phraseMode !== "1") {
          for (var i = 0; i < list.length; i++) {
            var entry = list[i]
            if (entry.query === normalized && entry.ids && entry.ids.length > 0) {
              self.historyCache = list
              self._hydrateFromCachedIds(entry.ids, token)
              return
            }
          }
        }
        self.historyCache = list
        self._startNormalSearch(normalized, token)
      },
      fail: function() {
        self.historyCache = []
        self._startNormalSearch(normalized, token)
      },
      complete: function() {}
    })
  },

  _startNormalSearch(normalized, token) {
    if (this.hasChinese(normalized)) {
      if (normalized.length === 1) {
        // Single character — skip cn_index (multi-character phrases only)
        this.performChineseSearch(normalized, token)
        return
      }
      this.collectCn2EnResults(normalized, [], {}, token, () => {
        if (token !== this.searchToken) {
          return
        }
        this._flushResults()
        this._stopFlushTimer()
        if (this.resultCards.length > 0) {
          this._saveSearchHistory()
          if (this.resultCards.length >= 20) {
            this._collectExtraEnglishIds(normalized, () => {
              this._finalizeAfterSearch()
            })
          } else {
            this.totalResultCount = this.resultCards.length
            this._finalizeAfterSearch()
          }
        } else {
          this.performChineseSearch(normalized, token)
        }
      })
      return
    }

    this.loadShardIndex(() => {
      if (token !== this.searchToken) {
        return
      }

      const results = []
      const seen = {}
      this.seenEntryId = {}

      if (this.searchMode === "inflect") {
        const first = normalized.charAt(0)
        if (first < "a" || first > "z") {
          this.finishEnglishSearch(normalized, token)
          return
        }
        const exactCandidates = []
        this.collectCompactWordCandidates("/common/dict/words/word_" + this._wordShardFor(normalized) + ".txt", normalized, exactCandidates, seen, "变形词典", 1, () => {
          if (token !== this.searchToken) {
            return
          }
          this.hydrateCompactCandidates(exactCandidates, results, 0, () => {
            if (token !== this.searchToken) {
              return
            }
            if (exactCandidates.length === 0) {
              this.finishEnglishSearch(normalized, token)
              return
            }
            this.collectInflectResult(normalized, results, seen, () => {
              if (token !== this.searchToken) {
                return
              }
              this.finishEnglishSearch(normalized, token)
            })
          })
        })
      } else {
        // 词组精准模式（由 search.ux 通过 phraseMode 参数传入）
        if (this.phraseMode === "1") {
          this.performPhraseSearch(normalized, token)
          return
        }

        this.collectEnglishResults(normalized, results, seen, () => {
          this.collectInflectResult(normalized, results, seen, () => {
            if (token !== this.searchToken) {
              return
            }

            this.finishEnglishSearch(normalized, token)
          })
        })
      }
    })
  },

  _hydrateFromCachedIds(ids, token) {
    var self = this
    var idList = ids.slice(0, 20)
    var groups = {}
    for (var i = 0; i < idList.length; i++) {
      var entryId = parseInt(idList[i], 10)
      if (!isNaN(entryId) && entryId >= 0) {
        var shard = this.entryShardFor(entryId)
        if (!groups[shard]) {
          groups[shard] = []
        }
        if (groups[shard].length < 20) {
          groups[shard].push(entryId)
        }
      }
    }

    var shardKeys = Object.keys(groups)
    if (shardKeys.length === 0) {
      this._startNormalSearch(this.queryText, token)
      return
    }
    var shardIdx = 0

    function loadNext() {
      if (shardIdx >= shardKeys.length || token !== self.searchToken) {
        done()
        return
      }

      var shard = shardKeys[shardIdx]
      var idsInShard = groups[shard]
      shardIdx++

      self.loadEntryShardItems(shard, idsInShard, function(entries) {
        if (token !== self.searchToken) return
        var seen = {}
        for (var i = 0; i < self.resultCards.length; i++) {
          seen[self.resultCards[i].id] = true
        }
        for (var j = 0; j < idsInShard.length; j++) {
          var entryId = idsInShard[j]
          var item = entries[entryId]
          if (item) {
            var lower = self.normalizeWord(item.word)
            if (!seen[lower] && self.resultCards.length < 20) {
              seen[lower] = true
              var card = self.createResultCard(entryId, lower, item.word, item.phonetic, item.translation, item.tag || "")
              self._enqueueCard(card)
            }
          }
        }
        loadNext()
      })
    }

    function done() {
      self._flushResults()
      self._stopFlushTimer()
      if (self.resultCards.length === 0) {
        self.statusText = "未找到"
      } else if (self.resultCards.length >= 20) {
        self._collectExtraEnglishIds(self.queryText, () => {
          self._finalizeAfterSearch()
        })
        return
      } else {
        self.totalResultCount = self.resultCards.length
        self._finalizeAfterSearch()
        return
      }
      self._appendNextButton()
    }

    loadNext()
  },

  finishEnglishSearch(query, token) {
    this._flushResults()
    if (this.resultCards.length === 0 && query.length > 2 && this.searchMode !== "inflect" && this.isEnglishWord(query)) {
      this.showToast("未找到，混淆搜索")
      this.statusText = "深度搜索"
      this.collectFuzzyResults(query, () => {
        if (token !== this.searchToken) {
          return
        }
        this._flushResults()
        this._stopFlushTimer()
        if (this.resultCards.length === 0) {
          this.statusText = "未找到"
        } else {
          this._saveSearchHistory()
          this._finishWithStatus("相近结果")
        }
      })
      return
    }

    this._stopFlushTimer()
    if (this.resultCards.length === 0) {
      this.statusText = "未找到"
    } else if (this.resultCards.length >= 20) {
      this._collectExtraEnglishIds(query, () => {
        this._finalizeAfterSearch()
      })
      return
    } else {
      this.totalResultCount = this.resultCards.length
      this._finalizeAfterSearch()
      return
    }
    this._saveSearchHistory()
    this._appendNextButton()
  },

  // 词组精准模式：跳过单词索引，全量匹配词组
  performPhraseSearch(query, token) {
    this.loadShardIndex(() => {
      if (token !== this.searchToken) {
        return
      }

      const results = []
      const seen = {}
      const shards = this.getCandidateShards(query)

      this.collectShardResults(shards, query, results, seen, 0, () => {
        if (token !== this.searchToken) {
          return
        }

        this._flushResults()
        this._stopFlushTimer()
        if (this.resultCards.length === 0) {
          this.statusText = "未找到"
        } else if (this.resultCards.length >= 20) {
          this._collectExtraEnglishIds(query, () => {
            this._finalizeAfterSearch()
          })
          return
        } else {
          this.totalResultCount = this.resultCards.length
          this._finalizeAfterSearch()
          return
        }
        this._saveSearchHistory()
        this._appendNextButton()
      }, "phrase")
    })
  },

  // 普通模式：单词结果不足10条时补充词组
  collectPhraseSupplement(query, token, done) {
    if (this.resultCards.length >= 10 || token !== this.searchToken) {
      done()
      return
    }

    // 计算词组限流数量
    var phraseLimit = 2
    if (query.length >= 2) {
      phraseLimit = 3
    }
    // 若精确命中单词索引，放宽至5条
    if (this.resultCards.length > 0) {
      phraseLimit = 5
    }

    const results = []
    const seen = {}
    // 标记已有的单词结果
    for (var i = 0; i < this.resultCards.length; i++) {
      seen[this.resultCards[i].id] = true
    }

    const shards = this.getCandidateShards(query)
    this.collectShardResults(shards, query, results, seen, 0, () => {
      if (token !== this.searchToken) {
        done()
        return
      }

      // 按排序规则排序：考试标签权重 > 词组长度（短优先）
      results.sort((a, b) => {
        const tagA = this._getTagWeight(a.tag)
        const tagB = this._getTagWeight(b.tag)
        if (tagA !== tagB) {
          return tagB - tagA
        }
        return a.word.length - b.word.length
      })

      // 限流：只添加指定数量的词组
      var added = 0
      for (var j = 0; j < results.length && added < phraseLimit; j++) {
        if (!this.resultCards.find(function(c) { return c.id === results[j].id })) {
          this._enqueueCard(results[j])
          added++
        }
      }

      done()
    })
  },

  // 普通英文搜索优先中高考单词
  _getNormalTagPriority(tag) {
    if (!tag) return 0
    if (tag.indexOf("zk") >= 0) return 2
    if (tag.indexOf("gk") >= 0) return 1
    return 0
  },

  // 获取考试标签权重
  _getTagWeight(tag) {
    if (!tag) return 0
    if (tag.indexOf("中考") >= 0) return 100
    if (tag.indexOf("高考") >= 0) return 90
    if (tag.indexOf("四级") >= 0) return 80
    if (tag.indexOf("六级") >= 0) return 70
    if (tag.indexOf("考研") >= 0) return 60
    if (tag.indexOf("雅思") >= 0) return 50
    if (tag.indexOf("托福") >= 0) return 50
    if (tag.indexOf("GRE") >= 0) return 40
    return 0
  },

  performChineseSearch(query, token) {
    const normalizedQuery = this.normalizeChineseText(query)
    if (!normalizedQuery) {
      this.resultCards = []
      this.statusText = ""
      return
    }

    this.loadChineseIds(normalizedQuery, (ids) => {
      if (token !== this.searchToken) {
        return
      }

      const results = []
      const seen = {}
      this.collectChineseResults(ids, normalizedQuery, results, seen, 0, token, () => {
        if (token !== this.searchToken) {
          return
        }

        this._flushResults()
        this._stopFlushTimer()
        if (this.resultCards.length === 0) {
          this.statusText = "未找到"
        } else if (this.resultCards.length >= 20) {
          this._collectExtraChineseIds(ids, () => {
            this._finalizeAfterSearch()
          })
          return
        } else {
          this.totalResultCount = this.resultCards.length
          this._finalizeAfterSearch()
          return
        }
        this._saveSearchHistory()
        this._appendNextButton()
      })
    })
  },

  loadChineseIds(query, done) {
    const firstChar = this.getFirstChineseChar(query)
    if (!firstChar) {
      done([])
      return
    }

    const bucket = this.zhBucketFor(firstChar)
    var found = false
    readLines(
      "/common/dict/zh_index/zh_" + bucket + ".txt",
      function (line) {
        const parts = line.split("\t")
        if (parts.length >= 2 && parts[0] === firstChar) {
          found = true
          done(decodeDeltaIds(parts[1]))
          return false
        }
      },
      function () {
        if (!found) {
          done([])
        }
      },
      function () {
        done([])
      }
    )
  },

  collectChineseResults(ids, query, results, seen, index, token, done) {
    if (token !== this.searchToken || this.destroyed || this.resultCards.length >= 20) {
      done()
      return
    }
    const grouped = this._groupIdsByShard(ids)
    const shardOrder = grouped.order
    const groups = grouped.groups
    let shardIndex = 0
    const self = this
    const nextShard = () => {
      if (token !== self.searchToken || self.destroyed || self.resultCards.length >= 20 || shardIndex >= shardOrder.length || shardIndex >= MAX_CHINESE_SCAN_SHARDS) {
        done()
        return
      }
      const shard = shardOrder[shardIndex]
      const wantedIds = groups[shard]
      shardIndex++
      self.loadEntryShardItems(shard, wantedIds, (entries) => {
        if (token !== self.searchToken || self.destroyed) {
          done()
          return
        }
        for (let i = 0; i < wantedIds.length && self.resultCards.length < 20; i++) {
          const entryId = wantedIds[i]
          const item = entries[entryId]
          if (!item) continue
          const lower = self.normalizeWord(item.word)
          if (!seen[lower] && self.normalizeChineseText(item.translation).indexOf(query) >= 0) {
            seen[lower] = true
            const card = self.createResultCard(entryId, lower, item.word, item.phonetic, item.translation, item.tag)
            results.push(card)
            self._enqueueCard(card)
          }
        }
        nextShard()
      })
    }
    nextShard()
  },

  loadCnMatches(bucket, query, done) {
    const cacheKey = bucket + "|" + query
    const cached = this.cnIndexCache.get(cacheKey)
    if (cached) {
      done(cached)
      return
    }

    const uri = "/common/dict/cn_index/cn_" + bucket + ".txt"
    if (this.destroyed) {
      done([])
      return
    }
    const ids = []
    const idSeen = {}
    var prevPhrase = ""
    var exactFound = false
    var prefixKeys = 0
    const self = this
    readLines(
      uri,
      function (line) {
        if (ids.length >= 50) {
          return false
        }
        const parts = line.split("\t")
        if (parts.length < 2) {
          return
        }
        const phrase = decodePrefixField(parts[0], prevPhrase)
        if (phrase === null) {
          return
        }
        prevPhrase = phrase

        if (phrase === query) {
          exactFound = true
          const list = decodeDeltaIds(parts[1]) || []
          for (let j = 0; j < list.length && ids.length < 50; j++) {
            const id = list[j]
            if (!idSeen[id]) {
              idSeen[id] = true
              ids.push(id)
            }
          }
          return false
        }

        if (!exactFound && phrase.indexOf(query) === 0) {
          prefixKeys++
          if (prefixKeys > 20) {
            return
          }
          const list = decodeDeltaIds(parts[1]) || []
          const limited = list.slice(0, 10)
          for (let j = 0; j < limited.length && ids.length < 50; j++) {
            const id = limited[j]
            if (!idSeen[id]) {
              idSeen[id] = true
              ids.push(id)
            }
          }
        }
      },
      function () {
        if (self.destroyed) {
          done([])
          return
        }
        self.cnIndexCache.set(cacheKey, ids)
        done(ids)
      },
      function () {
        done([])
      }
    )
  },

  collectCn2EnResults(query, results, seen, token, done) {
    if (token !== this.searchToken || this.destroyed) {
      done(results)
      return
    }
    const firstChar = this.getFirstChineseChar(query)
    if (!firstChar) {
      done(results)
      return
    }

    const bucket = this.cnBucketFor(firstChar)
    this.loadCnMatches(bucket, query, (ids) => {
      if (token !== this.searchToken || this.destroyed) {
        done(results)
        return
      }
      if (!ids || ids.length === 0) {
        done(results)
        return
      }
      this.fetchEntriesByIds(ids, results, seen, 0, token, done)
    })
  },

  fetchEntriesByIds(ids, results, seen, index, token, done) {
    if (token !== this.searchToken || this.destroyed || this.resultCards.length >= 20) {
      done(results)
      return
    }
    const grouped = this._groupIdsByShard(ids)
    const shardOrder = grouped.order
    const groups = grouped.groups
    let shardIndex = 0
    const self = this
    const nextShard = () => {
      if (token !== self.searchToken || self.destroyed || self.resultCards.length >= 20 || shardIndex >= shardOrder.length) {
        done(results)
        return
      }
      const shard = shardOrder[shardIndex]
      const wantedIds = groups[shard]
      shardIndex++
      self.loadEntryShardItems(shard, wantedIds, (entries) => {
        if (token !== self.searchToken || self.destroyed) {
          done(results)
          return
        }
        for (let i = 0; i < wantedIds.length && self.resultCards.length < 20; i++) {
          const entryId = wantedIds[i]
          const item = entries[entryId]
          if (!item) continue
          const lower = self.normalizeWord(item.word)
          if (!seen[lower]) {
            seen[lower] = true
            const card = self.createResultCard(entryId, lower, item.word, item.phonetic, item.translation, item.tag)
            results.push(card)
            self._enqueueCard(card)
          }
        }
        nextShard()
      })
    }
    nextShard()
  },

  // 只补 out 里还缺的 id，避免覆盖已从 partial 缓存取到的条目
  _fillMissingShardItems(out, store, source, wantedIds) {
    for (let i = 0; i < wantedIds.length; i++) {
      const entryId = wantedIds[i]
      if (out[entryId]) {
        continue
      }
      const item = source[entryId]
      if (item) {
        out[entryId] = item
        store[entryId] = item
      }
    }
  },

  loadEntryShard(shard, done) {
    const cached = this.entryCache.get(shard)
    if (cached) {
      done(cached)
      return
    }

    // 读之前先让出一个槽位：解析 500 条 entry 的瞬时内存和整读 30KB 文本不该叠加
    this.makeEntryRoom()

    const self = this
    const entries = {}
    const baseId = parseInt(shard, 10) * 500
    var previousWord = ""
    readLines(
      "/common/dict/entries/entry_" + shard + ".txt",
      function (line, index) {
        const parts = line.split("\t")
        if (parts.length < 3) {
          return
        }
        const entryId = baseId + index
        var word = decodePrefixField(parts[0], previousWord)
        if (word === null) {
          return
        }
        previousWord = word
        entries[entryId] = {
          word: word,
          phonetic: parts[1] || "",
          translation: parts[2] || "",
          tag: parts[3] || ""
        }
      },
      function () {
        if (self.destroyed) {
          done({})
          return
        }
        if (!self.pageHidden) {
          self.entryCache.set(shard, entries)
        }
        done(entries)
      },
      function () {
        done({})
      }
    )
  },

  _groupIdsByShard(ids) {
    const groups = {}
    const order = []
    for (let i = 0; i < ids.length; i++) {
      const entryId = this.parseEntryId(ids[i])
      if (entryId < 0) continue
      const shard = this.entryShardFor(entryId)
      if (!groups[shard]) {
        groups[shard] = []
        order.push(shard)
      }
      groups[shard].push(entryId)
    }
    return {groups: groups, order: order}
  },

  // entryCache 里既有全量片（key "26"）也有按需片（key "partial:26"），
  // 槽位不够时淘汰最旧的一片再读，避免读+解析同帧把堆顶穿。
  makeEntryRoom() {
    while (this.entryCache.size() >= ENTRY_CACHE_SLOTS) {
      const oldest = this.entryCache.oldest()
      if (oldest === undefined) break
      this.entryCache.delete(oldest)
    }
  },

  loadEntryShardItems(shard, wantedIds, done) {
    const cacheKey = "partial:" + shard
    // 按需片缓存是跨页累积的。命中它只能拿到「以前读过的那些 id」，
    // 缺的条目必须继续用全量片/文件补——早期版本在这里直接 done(out)，
    // 于是第 2 页起同一分片的新 id 全部解析失败，状态写着 20 条、列表却少卡。
    const store = this.entryCache.get(cacheKey) || {}
    const out = {}
    let missing = 0
    for (let i = 0; i < wantedIds.length; i++) {
      const entryId = wantedIds[i]
      const hit = store[entryId]
      if (hit) {
        out[entryId] = hit
      } else {
        missing++
      }
    }
    if (missing === 0) {
      done(out)
      return
    }

    const finish = () => {
      if (!this.pageHidden) {
        this.entryCache.set(cacheKey, store)
      }
      done(out)
    }

    // 若该分片已被 loadEntryShard 解析过（英文搜索 hydrate 必走那条路），
    // 直接从中挑需要的条目，不要为了 partial 键再去整读一遍 30KB。
    // 崩溃 1 的 34696B 分配就是同一文件 10 秒内被整读第二次。
    const full = this.entryCache.get(shard)
    if (full) {
      this._fillMissingShardItems(out, store, full, wantedIds)
      finish()
      return
    }

    this.makeEntryRoom()

    const uri = "/common/dict/entries/entry_" + shard + ".txt"
    const wanted = {}
    for (let i = 0; i < wantedIds.length; i++) {
      wanted[wantedIds[i]] = true
    }
    const baseId = parseInt(shard, 10) * 500
    var previousWord = ""
    const self = this
    readLines(
      uri,
      function (line, index) {
        const parts = line.split("\t")
        if (parts.length < 3) {
          return
        }
        const entryId = baseId + index
        var word = decodePrefixField(parts[0], previousWord)
        if (word === null) {
          return
        }
        previousWord = word
        if (!wanted[entryId] || out[entryId]) {
          return
        }
        const item = {
          word: word,
          phonetic: parts[1] || "",
          translation: parts[2] || "",
          tag: parts[3] || ""
        }
        out[entryId] = item
        store[entryId] = item
      },
      function () {
        if (self.destroyed) {
          done(out)
          return
        }
        finish()
      },
      function () {
        done(out)
      }
    )
  },

  loadShardIndex(done) {
    if (this.shardIndex) {
      done()
      return
    }

    const index = {}
    for (let i = 0; i < WORD_INDEX_LETTERS.length; i++) {
      const letter = WORD_INDEX_LETTERS.charAt(i)
      index[letter] = [letter]
    }
    this.shardIndex = index
    done()
  },

  // Map a word query to the smallest shard that holds its candidates.
  // 2+ chars with an alpha 2nd char -> 2-letter shard (e.g. "test" -> "te");
  // otherwise -> 1-letter file (single char, or rare non-alpha 2nd char).
  _useTwoLetterShards() {
    const profile = getDictionaryProfile()
    return !!(profile && profile.wordTwoShards > 0)
  },

  _wordShardFor(q) {
    const s = this.normalizeWord(q)
    if (this._useTwoLetterShards() && s.length >= 2 && s.charAt(1) >= "a" && s.charAt(1) <= "z") {
      return s.slice(0, 2)
    }
    return s.charAt(0)
  },

  getCandidateShards(query) {
    const q = this.normalizeWord(query)
    const first = q.charAt(0)
    if (first >= "a" && first <= "z") {
      if (this._useTwoLetterShards() && q.length >= 2 && q.charAt(1) >= "a" && q.charAt(1) <= "z") {
        return [q.slice(0, 2)]
      }
      return [first]
    }
    return []
  },

  collectEnglishResults(query, results, seen, done) {
    const shards = this.getCandidateShards(query)
    const candidates = []
    const self = this
    let shardIndex = 0

    const nextShard = () => {
      if (self.destroyed || shardIndex >= shards.length || candidates.length >= 80) {
        // 中高考优先，同优先级保持分片原始顺序
        candidates.sort((a, b) => {
          const pa = self._getNormalTagPriority(a.tag)
          const pb = self._getNormalTagPriority(b.tag)
          if (pa !== pb) {
            return pb - pa
          }
          return a._order - b._order
        })
        self.hydrateCompactCandidates(candidates, results, 0, done)
        return
      }
      const shard = shards[shardIndex]
      shardIndex++
      const before = candidates.length
      self.collectCompactWordCandidates("/common/dict/words/word_" + shard + ".txt", query, candidates, seen, "", 80 - before, () => {
        if (self.destroyed) {
          done()
          return
        }
        for (let i = before; i < candidates.length; i++) {
          candidates[i]._order = i
        }
        nextShard()
      })
    }

    nextShard()
  },

  collectShardResults(shards, query, results, seen, index, done, source) {
    if (index >= shards.length || this.resultCards.length >= 20) {
      done()
      return
    }

    const shard = shards[index]
    const candidates = []
    this.collectCompactWordCandidates("/common/dict/words/word_" + shard + ".txt", query, candidates, seen, source || "", 20 - this.resultCards.length, () => {
      this.hydrateCompactCandidates(candidates, results, 0, () => {
        this.collectShardResults(shards, query, results, seen, index + 1, done, source)
      })
    })
  },

  collectInflectResult(query, results, seen, done) {
    if (this.resultCards.length >= 20 || query.length < 2) {
      done()
      return
    }

    const shard = this.keyFor(query)
    const bases = []
    var previousForm = ""
    var formMatched = false
    const selfForm = this
    readLines(
      "/common/dict/inflect/inflect_" + shard + ".txt",
      function (line) {
        if (formMatched) {
          return false
        }
        const parts = line.split("\t")
        if (parts.length < 2) {
          return
        }
        const form = decodePrefixField(parts[0], previousForm)
        if (form === null) {
          return
        }
        previousForm = form
        if (form === query) {
          formMatched = true
          const ids = parts[1].split(",")
          for (let j = 0; j < ids.length; j++) {
            const entryId = parseBase36(ids[j])
            if (entryId >= 0) {
              bases.push(entryId)
            }
          }
          return false
        }
      },
      function () {
        selfForm.collectBaseResults(bases, results, seen, 0, () => {
          selfForm.collectReverseInflectResult(query, results, seen, done)
        })
      },
      function () {
        selfForm.collectBaseResults(bases, results, seen, 0, () => {
          selfForm.collectReverseInflectResult(query, results, seen, done)
        })
      }
    )
  },

  collectReverseInflectResult(query, results, seen, done) {
    if (this.resultCards.length >= 20) {
      done()
      return
    }

    const shard = this.keyFor(query)
    const forms = []
    var previousBase = ""
    var baseMatched = false
    const selfReverse = this
    readLines(
      "/common/dict/inflect_reverse/ireverse_" + shard + ".txt",
      function (line) {
        if (baseMatched) {
          return false
        }
        const parts = line.split("\t")
        if (parts.length < 2) {
          return
        }
        const base = decodePrefixField(parts[0], previousBase)
        if (base === null) {
          return
        }
        previousBase = base
        if (base === query) {
          baseMatched = true
          const values = parts[1].split(",")
          for (let j = 0; j < values.length; j++) {
            const value = values[j]
            if (!value) {
              continue
            }
            if (value.charAt(0) === "@") {
              const entryId = parseBase36(value.slice(1))
              if (entryId >= 0) {
                forms.push(entryId)
              }
            } else if (value !== query && !seen[value]) {
              forms.push(value)
            }
          }
          return false
        }
      },
      function () {
        selfReverse.collectFormResults(query, forms, results, seen, 0, done)
      },
      function () {
        selfReverse.collectFormResults(query, forms, results, seen, 0, done)
      }
    )
  },

  collectFormResults(baseWord, forms, results, seen, index, done) {
    if (index >= forms.length || this.resultCards.length >= 20) {
      done()
      return
    }

    const form = forms[index]
    if (typeof form === "number") {
      const shard = this.entryShardFor(form)
      // 变形结果也是按需取：为一条 entry 整片解析 500 行不值得
      this.loadEntryShardItems(shard, [form], (entries) => {
        const item = entries[form]
        if (item && !this.seenEntryId[form]) {
          this.seenEntryId[form] = true
          const lower = this.normalizeWord(item.word)
          if (!seen[lower]) {
            seen[lower] = true
          }
          const card = this.createResultCard(form, lower, item.word, item.phonetic, item.translation, "变形")
          results.push(card)
          this._enqueueCard(card)
        }
        this.collectFormResults(baseWord, forms, results, seen, index + 1, done)
      })
      return
    }
    const lower = this.normalizeWord(form)
    if (!lower || seen[lower]) {
      this.collectFormResults(baseWord, forms, results, seen, index + 1, done)
      return
    }
    seen[lower] = true

    // 先查词库，有则用词库释义；无则用词根释义
    const first = lower.charAt(0)
    if (first >= "a" && first <= "z") {
      const candidates = []
      this.collectCompactWordCandidates("/common/dict/words/word_" + this._wordShardFor(form) + ".txt", form, candidates, seen, "变形", 1, () => {
        if (candidates.length > 0) {
          this.hydrateCompactCandidates(candidates, results, 0, () => {
            this.collectFormResults(baseWord, forms, results, seen, index + 1, done)
          })
        } else {
          this.hydrateFromBaseWord(baseWord, form, results, () => {
            this.collectFormResults(baseWord, forms, results, seen, index + 1, done)
          })
        }
      })
    } else {
      this.collectFormResults(baseWord, forms, results, seen, index + 1, done)
    }
  },

  hydrateFromBaseWord(baseWord, displayWord, results, done) {
    const first = this.normalizeWord(baseWord).charAt(0)
    if (first < "a" || first > "z") {
      done()
      return
    }
    var prevWord = ""
    var baseHandled = false
    const selfBase = this
    readLines(
      "/common/dict/words/word_" + this._wordShardFor(baseWord) + ".txt",
      function (line, index) {
        if (baseHandled || index >= FUZZY_SCAN_LIMIT) {
          return false
        }
        const parts = line.split("\t")
        if (parts.length < 3) {
          prevWord = ""
          return
        }
        var word = selfBase._decodeWordPrefix(parts, prevWord)
        prevWord = word
        if (word.toLowerCase() === baseWord.toLowerCase()) {
          const entryId = selfBase.parseEntryId(parts[1])
          if (entryId >= 0) {
            baseHandled = true
            const shard = selfBase.entryShardFor(entryId)
            selfBase.loadEntryShard(shard, (entries) => {
              const item = entries[entryId]
              if (item && !selfBase.seenEntryId[entryId]) {
                selfBase.seenEntryId[entryId] = true
                const card = selfBase.createResultCard(
                  entryId,
                  selfBase.normalizeWord(displayWord),
                  displayWord,
                  item.phonetic,
                  item.translation,
                  "变形"
                )
                results.push(card)
                selfBase._enqueueCard(card)
              }
              done()
            })
            return false
          }
        }
      },
      function () {
        if (!baseHandled) {
          done()
        }
      },
      function () {
        if (!baseHandled) {
          done()
        }
      }
    )
  },

  collectBaseResults(bases, results, seen, index, done) {
    if (index >= bases.length || this.resultCards.length >= 20) {
      done()
      return
    }

    const base = bases[index]
    if (typeof base === "number") {
      const shard = this.entryShardFor(base)
      // 词根结果同样按需取，避免为一条 entry 解析整片
      this.loadEntryShardItems(shard, [base], (entries) => {
        const item = entries[base]
        if (item && !this.seenEntryId[base]) {
          this.seenEntryId[base] = true
          const lower = this.normalizeWord(item.word)
          if (!seen[lower]) {
            seen[lower] = true
          }
          const card = this.createResultCard(base, lower, item.word, item.phonetic, item.translation, "变形")
          results.push(card)
          this._enqueueCard(card)
        }
        this.collectBaseResults(bases, results, seen, index + 1, done)
      })
      return
    }
    const first = this.normalizeWord(base).charAt(0)
    if (first < "a" || first > "z") {
      this.collectBaseResults(bases, results, seen, index + 1, done)
      return
    }

    const candidates = []
    this.collectCompactWordCandidates("/common/dict/words/word_" + this._wordShardFor(base) + ".txt", base, candidates, seen, "变形", 1, () => {
      this.hydrateCompactCandidates(candidates, results, 0, () => {
        this.collectBaseResults(bases, results, seen, index + 1, done)
      })
    })
  },

  _decodeWordPrefix(parts, prevWord) {
    return decodePrefixField(parts[0], prevWord) || ""
  },

  // 分块流式扫描词分片：不再整读 67KB 的 word_t.txt，单次分配上限是 4KB 块 + 一行。
  collectCompactWordCandidates(uri, query, candidates, seen, source, limit, done) {
    const finish = function () {
      if (done) {
        done()
      }
    }
    if (limit <= 0) {
      finish()
      return
    }
    const normalizedQuery = this.normalizeWord(query)
    const self = this
    var prevWord = ""
    readLines(
      uri,
      function (line) {
        if (candidates.length >= limit) {
          return false
        }
        const parts = line.split("\t")
        if (parts.length < 3) {
          return
        }
        const word = self._decodeWordPrefix(parts, prevWord)
        prevWord = word
        const lower = self.normalizeWord(word)
        if (!lower || seen[lower]) {
          return
        }
        if (source === "phrase") {
          if (lower.indexOf(" ") < 0 || lower.indexOf(normalizedQuery) !== 0) {
            return
          }
        } else if (source) {
          if (lower !== normalizedQuery) {
            return
          }
        } else {
          if (lower.indexOf(" ") >= 0 || lower.indexOf(normalizedQuery) !== 0) {
            return
          }
        }
        const entryId = self.parseEntryId(parts[1])
        if (entryId < 0) {
          return
        }
        seen[lower] = true
        candidates.push({
          entryId: entryId,
          lower: lower,
          word: word,
          tag: self._expandTag(parts[2] || ""),
          source: source
        })
      },
      finish,
      finish
    )
  },

  // 卡片/缓存内存记账：一行一条，便于整份日志里 grep [MEMCARD]。
  // 精确计数：cards（屏上卡片）、nodes（模板元素数）、chars（卡片里驻留的字符数）、
  //           cache（entryCache 的分片/条目数）。
  // 折算估值：estJS 用 QuickJS 真实单价，estNat 用每节点 250~400B 的区间。
  logCardMemory(tag) {
    const cards = (this.resultCards && this.resultCards.length > 0)
      ? this.resultCards
      : (this.pendingCards || [])
    let nodes = 0
    let chars = 0
    let strings = 0
    let objects = 0
    for (let i = 0; i < cards.length; i++) {
      const card = cards[i]
      if (!card) continue
      objects++
      const lines = card.translationLines || []
      const lineCount = lines.length > 0 ? lines.length : 1
      nodes += MEM_CARD_FIXED_NODES + lineCount
      const fields = [card.id, card.word, card.phonetic, card.rawPhonetic,
        card.translation, card.tag, card.rawTag, card.fullTag]
      for (let k = 0; k < fields.length; k++) {
        const value = fields[k]
        if (typeof value === "string" && value.length > 0) {
          strings++
          chars += value.length
        }
      }
      for (let j = 0; j < lines.length; j++) {
        const line = lines[j] || ""
        if (line.length > 0) {
          strings++
          chars += line.length
        }
      }
    }
    const estJS = objects * (MEM_OBJ_BYTES + MEM_CARD_PROPS * MEM_PROP_BYTES) + strings * MEM_STR_BYTES + chars
    const cache = this.entryCacheStats()
    console.log("[MEMCARD] " + tag + " cards=" + objects + " nodes=" + nodes +
      " chars=" + chars + " strs=" + strings + " estJS=" + estJS + "B" +
      " estNat=" + (nodes * MEM_NODE_BYTES_LO) + "-" + (nodes * MEM_NODE_BYTES_HI) + "B" +
      " cache=" + cache.keys + "(f" + cache.full + "/p" + cache.partial + ")" +
      " items=" + cache.items + " cacheChars=" + cache.chars)
  },

  entryCacheStats() {
    const stat = {keys: 0, full: 0, partial: 0, items: 0, chars: 0}
    const cache = this.entryCache
    if (!cache || !cache.order) {
      return stat
    }
    stat.keys = cache.order.length
    for (let i = 0; i < cache.order.length; i++) {
      const key = cache.order[i]
      const value = cache.cache[key]
      if (!value) continue
      if (key.indexOf("partial:") === 0) {
        stat.partial++
      } else {
        stat.full++
      }
      for (const id in value) {
        const item = value[id]
        if (!item) continue
        stat.items++
        stat.chars += (item.word || "").length + (item.phonetic || "").length +
          (item.translation || "").length + (item.tag || "").length
      }
    }
    return stat
  },

  // 按需解析：一屏只用 20 条 entry，但旧实现对候选逐条调 loadEntryShard，
  // 把整片 500 行都解析成对象驻留缓存（entry_26.txt 实测 500 行 ≈ 100KB JS 堆，
  // 两个槽位就是 200KB），实际只取其中 20 条。现在先把候选按分片分组，
  // 再用 loadEntryShardItems 只解析这一屏要显示的 entryId，其余 480 条不建对象。
  // 省的是对象不是 I/O：该分片的字节仍然流式扫一遍（4KB 块），翻页缺 id 时才重扫。
  hydrateCompactCandidates(candidates, results, index, done) {
    if (this.destroyed) {
      done()
      return
    }
    const room = 20 - this.resultCards.length - (this.pendingCards ? this.pendingCards.length : 0)
    if (room <= 0 || index >= candidates.length) {
      done()
      return
    }

    // 只挑这一屏还装得下的候选，按分片分组；order 记住分片首次出现的顺序
    const picked = []
    const groups = {}
    const order = []
    let cursor = index
    for (; cursor < candidates.length && picked.length < room; cursor++) {
      const candidate = candidates[cursor]
      if (!candidate || this.seenEntryId[candidate.entryId]) {
        continue
      }
      const shard = this.entryShardFor(candidate.entryId)
      if (!groups[shard]) {
        groups[shard] = []
        order.push(shard)
      }
      groups[shard].push(candidate.entryId)
      picked.push(candidate)
    }
    if (picked.length === 0) {
      done()
      return
    }

    const found = {}
    const self = this
    let shardIndex = 0

    const buildCards = () => {
      // 卡片必须按候选排名顺序建，不能按分片顺序建，否则结果页排序会变
      for (let i = 0; i < picked.length; i++) {
        if (self.resultCards.length + (self.pendingCards ? self.pendingCards.length : 0) >= 20) {
          break
        }
        const candidate = picked[i]
        if (self.seenEntryId[candidate.entryId]) {
          continue
        }
        const item = found[candidate.entryId]
        if (!item) {
          continue
        }
        self.seenEntryId[candidate.entryId] = true
        const card = self.createResultCard(
          candidate.entryId,
          candidate.lower,
          item.word || candidate.word,
          item.phonetic,
          item.translation,
          item.tag || candidate.tag || candidate.source
        )
        results.push(card)
        self._enqueueCard(card)
      }
      self.hydrateCompactCandidates(candidates, results, cursor, done)
    }

    const loadNext = () => {
      if (self.destroyed || shardIndex >= order.length) {
        buildCards()
        return
      }
      const shard = order[shardIndex]
      shardIndex++
      self.loadEntryShardItems(shard, groups[shard], (entries) => {
        if (entries) {
          for (const id in entries) {
            if (entries[id]) {
              found[id] = entries[id]
            }
          }
        }
        loadNext()
      })
    }

    loadNext()
  },

  collectFuzzyResults(query, done) {
    if (query.length <= 2) {
      done([])
      return
    }
    const shards = this.getFuzzyShards(query)
    const items = []
    const seen = {}
    this.fuzzyWordsChecked = 0
    this.collectFuzzyShardResults(shards, query, items, seen, 0, () => {
      items.sort((left, right) => {
        if (left.distance !== right.distance) {
          return left.distance - right.distance
        }
        if (right.score !== left.score) {
          return right.score - left.score
        }
        return left.word.length - right.word.length
      })

      const candidates = []
      for (let i = 0; i < items.length; i++) {
        candidates.push({
          entryId: items[i].entryId,
          lower: items[i].lower,
          word: items[i].word,
          tag: items[i].tag,
          source: "相近"
        })
      }
      const cards = []
      this.hydrateCompactCandidates(candidates, cards, 0, () => done())
    })
  },

  getFuzzyShards(query) {
    const ordered = []
    const seen = {}
    const first = this.normalizeWord(query).charAt(0)
    if (first >= "a" && first <= "z") {
      this.pushUniqueShards(ordered, seen, [first])
    }
    for (let i = 0; i < WORD_INDEX_LETTERS.length; i++) {
      this.pushUniqueShards(ordered, seen, [WORD_INDEX_LETTERS.charAt(i)])
    }
    return ordered
  },

  pushUniqueShards(output, seen, shards) {
    for (let i = 0; i < shards.length; i++) {
      const shard = shards[i]
      if (shard && !seen[shard]) {
        seen[shard] = true
        output.push(shard)
      }
    }
  },

  collectFuzzyShardResults(shards, query, items, seen, index, done) {
    if (
      index >= shards.length ||
      items.length >= FUZZY_POOL_LIMIT ||
      this.fuzzyWordsChecked >= FUZZY_SCAN_LIMIT
    ) {
      done()
      return
    }

    const shard = shards[index]
    this.scanFuzzyWordUri("/common/dict/words/word_" + shard + ".txt", query, items, seen, () => {
      this.collectFuzzyShardResults(shards, query, items, seen, index + 1, done)
    })
  },

  // 分块流式模糊扫描：每行一个回调，扫满 FUZZY_SCAN_LIMIT 立即停读
  scanFuzzyWordUri(uri, query, items, seen, done) {
    var prevWord = ""
    const self = this
    readLines(
      uri,
      function (line) {
        if (items.length >= FUZZY_POOL_LIMIT || self.fuzzyWordsChecked >= FUZZY_SCAN_LIMIT) {
          return false
        }
        self.fuzzyWordsChecked++
        const parts = line.split("\t")
        if (parts.length < 3) {
          return
        }
        const word = self._decodeWordPrefix(parts, prevWord)
        prevWord = word
        const lower = self.normalizeWord(word)
        if (!lower || seen[lower] || Math.abs(lower.length - query.length) > 2) {
          return
        }
        const distance = self.editDistanceBounded(query, lower, 2)
        if (distance < 0 || distance > 2) {
          return
        }
        const entryId = self.parseEntryId(parts[1])
        if (entryId < 0) {
          return
        }
        var tagStr = self._expandTag(parts[2] || "")
        seen[lower] = true
        items.push({
          entryId: entryId,
          lower: lower,
          word: word,
          tag: tagStr,
          distance: distance,
          score: self.scoreFuzzyCandidate(query, lower, tagStr)
        })
      },
      function () {
        done()
      },
      function () {
        done()
      }
    )
  },

  editDistanceBounded(left, right, limit) {
    const leftLength = left.length
    const rightLength = right.length
    if (Math.abs(leftLength - rightLength) > limit) {
      return -1
    }

    let previous = []
    let current = []
    for (let j = 0; j <= rightLength; j++) {
      previous[j] = j
    }

    for (let i = 1; i <= leftLength; i++) {
      current = [i]
      let rowMin = current[0]
      const from = Math.max(1, i - limit)
      const to = Math.min(rightLength, i + limit)

      for (let j = 1; j < from; j++) {
        current[j] = limit + 1
      }
      for (let j = from; j <= to; j++) {
        const cost = left.charAt(i - 1) === right.charAt(j - 1) ? 0 : 1
        const deletion = previous[j] + 1
        const insertion = current[j - 1] + 1
        const substitution = previous[j - 1] + cost
        const value = Math.min(deletion, insertion, substitution)
        current[j] = value
        if (value < rowMin) {
          rowMin = value
        }
      }
      for (let j = to + 1; j <= rightLength; j++) {
        current[j] = limit + 1
      }
      if (rowMin > limit) {
        return -1
      }
      previous = current
    }

    const result = previous[rightLength]
    return result <= limit ? result : -1
  },

  scoreFuzzyCandidate(query, word, tag) {
    let score = 80 - Math.abs(word.length - query.length) * 8
    const tags = tag || ""
    if (word.charAt(0) === query.charAt(0)) {
      score += 20
    }
    if (tags.indexOf("zk") >= 0) {
      score += 40
    }
    if (tags.indexOf("gk") >= 0) {
      score += 36
    }
    if (tags.indexOf("cet4") >= 0) {
      score += 30
    }
    if (tags.indexOf("cet6") >= 0 || tags.indexOf("ky") >= 0) {
      score += 18
    }
    if (tags.indexOf("toefl") >= 0 || tags.indexOf("ielts") >= 0) {
      score += 8
    }
    if (tags.indexOf("gre") >= 0) {
      score -= 8
    }
    return score
  },

  highestTag(tag) {
    if (!tag) return ""
    const tags = tag.split(" ")
    const priority = ["zk", "gk", "cet4", "cet6", "ky", "ielts", "toefl", "gre"]
    let best = tags[0] || ""
    let bestIdx = -1
    for (let i = 0; i < tags.length; i++) {
      const idx = priority.indexOf(tags[i])
      if (idx > bestIdx) {
        bestIdx = idx
        best = tags[i]
      }
    }
    return best
  },

  _enqueueCard(card) {
    if (this.pendingCards.length >= 20) {
      return
    }
    this.pendingCards.push(card)
  },

  _flushResults() {
    if (this.pendingCards.length === 0) {
      return
    }
    var remaining = 20 - this.resultCards.length
    if (remaining <= 0) {
      this.pendingCards = []
      return
    }
    var batch = this.pendingCards.splice(0, remaining)
    for (var i = 0; i < batch.length; i++) {
      this.resultCards.push(batch[i])
    }
    this.resultCards = this.resultCards.slice()
    this.logCardMemory("flush")
  },

  _startFlushTimer() {
    this._stopFlushTimer()
    var self = this
    // 每次 flush 都会整体替换 resultCards 数组，列表项全部重整；
    // 崩 4（17:57:5x）里成片的 computeByClassList: classList is null 就是重整带来的。
    // 加载期间少重整几次，碎片和 native 侧重建都少。
    this.flushTimer = setInterval(function () { self._flushResults() }, 2500)
  },

  _stopFlushTimer() {
    if (this.flushTimer) {
      clearInterval(this.flushTimer)
      this.flushTimer = null
    }
  },

  _parseHistoryList(data) {
    if (!data) {
      return []
    }
    var text = data.value || data || ""
    if (!text) {
      return []
    }
    try {
      var list = JSON.parse(text)
      if (list && list.length) {
        return list
      }
    } catch (e) {}
    return []
  },

  _saveSearchHistory() {
    if (this.historySavePending) {
      return
    }
    var query = this.queryText
    if (!query) {
      return
    }

    var ids = []
    var seen = {}
    var cards = this.resultCards || []
    for (var i = 0; i < cards.length; i++) {
      var entryId = parseInt(cards[i].entryId, 10)
      if (!isNaN(entryId) && entryId >= 0 && !seen[entryId]) {
        seen[entryId] = true
        ids.push(entryId)
      }
    }

    if (ids.length === 0) {
      return
    }

    this.historySavePending = true
    var self = this
    storage.get({
      key: "dic_history",
      success: function(data) {
        self._writeHistoryBlock(data, query, ids)
      },
      fail: function() {
        self._writeHistoryBlock(null, query, ids)
      },
      complete: function() {}
    })
  },

  _writeHistoryBlock(data, query, ids) {
    var list = this._parseHistoryList(data)
    var type = this.phraseMode === "1" ? "phrase" : "word"
    var item = {query: query, type: type}
    if (ids.length > 0) {
      item.ids = ids
    }

    var output = [item]
    for (var i = 0; i < list.length && output.length < 20; i++) {
      var oldItem = list[i]
      if (oldItem && oldItem.query && (this.normalizeWord(oldItem.query) !== query || (oldItem.type || "word") !== type)) {
        output.push(oldItem)
      }
    }

    this.historyCache = output

    storage.set({
      key: "dic_history",
      value: JSON.stringify(output),
      success: function() {
        this.historySavePending = false
      }.bind(this),
      fail: function() {
        this.historySavePending = false
      }.bind(this),
      complete: function() {}
    })
  },

  _appendNextButton() {
    if (this.totalResultCount > 20 && this.resultCards.length > 0 && this.resultCards[this.resultCards.length - 1].recordKind !== "next-page") {
      this.resultCards.push({
        id: "next_page",
        recordKind: "next-page",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordFontSize: 18,
        translationLines: [""],
        tag: "",
        rawTag: "",
        phonetic: "",
        word: ""
      })
      this.resultCards = this.resultCards.slice()
    }
  },

  _finalizeAfterSearch() {
    // Merge first-20 entryIds into collectedIds for uniform page access
    if (this.resultCards.length <= 0) return
    var allIds = []
    var seen = {}
    for (var i = 0; i < this.resultCards.length; i++) {
      var eid = this.resultCards[i].entryId
      if (eid >= 0 && !seen[eid]) {
        seen[eid] = true
        allIds.push(eid)
      }
    }
    for (var i = 0; i < this.collectedIds.length; i++) {
      if (!seen[this.collectedIds[i]]) {
        seen[this.collectedIds[i]] = true
        allIds.push(this.collectedIds[i])
      }
    }
    this.mightHaveMore = this.collectedIds.length >= 40
    this.collectedIds = allIds
    this.totalResultCount = allIds.length
    this._updatePaginationStatus()
    this._saveSearchHistory()
    this._appendNextButton()
    // 一次搜索刚结束是碎片最多的时候（分片解析、排序、20 张卡），先收掉再让界面继续动
    if (typeof global !== "undefined" && typeof global.runGC === "function") {
      global.runGC()
    }
    this.logCardMemory("final")
  },

  _finishWithStatus(baseStatus) {
    if (this.resultCards.length >= 20) {
      var self = this
      this._collectExtraEnglishIds(this.queryText, function() {
        self._finalizeAfterSearch()
      })
    } else {
      this.totalResultCount = this.resultCards.length
      var prefix = this.phraseMode === "1" ? "短语" : ""
      this.statusText = prefix + baseStatus + " " + this.resultCards.length + "条"
      this._saveSearchHistory()
      this._appendNextButton()
    }
  },

  _updatePaginationStatus() {
    var total = this.totalResultCount
    var pageNum = this.searchPage + 1
    var prefix = this.phraseMode === "1" ? "短语" : ""
    if (total <= 20) {
      this.statusText = prefix + "找到" + total + "条"
    } else if (this.mightHaveMore) {
      this.statusText = prefix + "当前第" + pageNum + "页，最多加载60条"
    } else {
      this.statusText = prefix + "当前第" + pageNum + "页，一共" + total + "条"
    }
  },

  _collectExtraEnglishIds(query, done) {
    // 词组模式不补充英文词，只保留词组结果
    if (this.phraseMode === "1") {
      done()
      return
    }
    var first = query.charAt(0)
    if (first < "a" || first > "z") {
      done()
      return
    }
    var token = this.searchToken
    var self = this
    var seen = {}
    for (var i = 0; i < self.resultCards.length; i++) {
      seen[self.resultCards[i].id] = true
    }
    var idSeen = {}
    for (var i = 0; i < self.collectedIds.length; i++) {
      idSeen[self.collectedIds[i]] = true
    }
    var prevWord = ""
    var normalizedQuery = self.normalizeWord(query)
    readLines(
      "/common/dict/words/word_" + this._wordShardFor(query) + ".txt",
      function (line) {
        if (token !== self.searchToken) {
          return false
        }
        if (self.collectedIds.length >= 40) {
          return false
        }
        var parts = line.split("\t")
        if (parts.length < 3) {
          return
        }
        var word = self._decodeWordPrefix(parts, prevWord)
        prevWord = word
        var lower = self.normalizeWord(word)
        if (!lower || seen[lower]) {
          return
        }
        if (lower.indexOf(normalizedQuery) !== 0) {
          return
        }
        seen[lower] = true
        var entryId = self.parseEntryId(parts[1])
        if (entryId >= 0 && !idSeen[entryId]) {
          idSeen[entryId] = true
          self.collectedIds.push(entryId)
        }
      },
      function () {
        done()
      },
      function () {
        done()
      }
    )
  },

  _collectExtraChineseIds(ids, done) {
    var seen = {}
    for (var i = 0; i < this.resultCards.length; i++) {
      seen[this.resultCards[i].entryId] = true
    }
    for (var i = 0; i < ids.length && this.collectedIds.length < 40; i++) {
      var entryId = this.parseEntryId(ids[i])
      if (entryId >= 0 && !seen[entryId]) {
        seen[entryId] = true
        this.collectedIds.push(entryId)
      }
    }
    done()
  },

  _goToNextPage() {
    prompt.showToast({
      message: "加载中…",
      duration: 3000
    })
    this.searchPage++
    var self = this
    this._loadAndRenderPage(function() {
      setTimeout(function() {
        var list = self.$element("result-list")
        if (list && list.scrollTo) {
          list.scrollTo({index: 0})
        }
      }, 100)
    })
  },

  _goToPrevPage() {
    prompt.showToast({
      message: "加载中…",
      duration: 3000
    })
    this.searchPage--
    var self = this
    this._loadAndRenderPage(function() {
      setTimeout(function() {
        var list = self.$element("result-list")
        if (list && list.scrollTo && self.resultCards.length > 0) {
          list.scrollTo({index: self.resultCards.length - 1})
        }
      }, 100)
    })
  },

  _loadAndRenderPage(callback) {
    var self = this
    var pageSize = 20
    var start = this.searchPage * pageSize
    var end = Math.min(start + pageSize, this.totalResultCount, 60)
    var pageIds = this.collectedIds.slice(start, end)

    var groups = {}
    for (var i = 0; i < pageIds.length; i++) {
      var shard = this.entryShardFor(pageIds[i])
      if (!groups[shard]) groups[shard] = []
      groups[shard].push(pageIds[i])
    }

    var shardKeys = Object.keys(groups)
    var newCards = []
    var shardIdx = 0
    var wordSeen = {}

    function loadNext() {
      if (shardIdx >= shardKeys.length) {
        self._buildPageView(newCards, callback)
        return
      }
      var shard = shardKeys[shardIdx]
      var idsInShard = groups[shard]
      shardIdx++
      self.loadEntryShardItems(shard, idsInShard, function(entries) {
        for (var j = 0; j < idsInShard.length; j++) {
          var entryId = idsInShard[j]
          var item = entries[entryId]
          if (item) {
            var lower = self.normalizeWord(item.word)
            if (!wordSeen[lower]) {
              wordSeen[lower] = true
              var card = self.createResultCard(entryId, lower, item.word, item.phonetic, item.translation, item.tag || "")
              newCards.push(card)
            }
          }
        }
        loadNext()
      })
    }

    loadNext()
  },

  _buildPageView(cards, callback) {
    var pageCards = []
    if (this.searchPage > 0) {
      pageCards.push({
        id: "prev_page",
        recordKind: "prev-page",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordFontSize: 18,
        translationLines: [""],
        tag: "",
        rawTag: "",
        phonetic: "",
        word: ""
      })
    }
    for (var i = 0; i < cards.length; i++) {
      pageCards.push(cards[i])
    }
    var nextStart = (this.searchPage + 1) * 20
    if (nextStart < this.totalResultCount && nextStart < 60) {
      pageCards.push({
        id: "next_page",
        recordKind: "next-page",
        cardHeight: 56,
        itemHeight: 66,
        wordMarqueeOn: false,
        wordFontSize: 18,
        translationLines: [""],
        tag: "",
        rawTag: "",
        phonetic: "",
        word: ""
      })
    }
    this.resultCards = pageCards
    this._updatePaginationStatus()
    this.logCardMemory("page")
    if (callback) callback()
  },

  createResultCard(entryId, id, word, phonetic, translation, tag) {
    // Decode phrase markers for display (IPA is stored as ASCII-safe encoding, used as-is)
    phonetic = phonetic || ""
    translation = this._decodePhrase(translation || "")
    // Ensure tag is expanded — defense against raw hex bitmask reaching display layer
    tag = this._expandTag(tag || "")
    const maxW = this.contentWidth
    const cacheKey = translation + "|" + maxW
    var lines = this.wrapCache[cacheKey]
    if (!lines) {
      lines = this.wrapText(translation || "", maxW)
      if (this.wrapCache) {
        if (Object.keys(this.wrapCache).length >= 50) {
          this.wrapCache = {}
        }
        this.wrapCache[cacheKey] = lines
      }
    }
    const safeLines = lines.length > 0 ? lines : [""]
    // 真机实测卡片内容高：上内边距 12 + 单词行 34(28×1.2) + 音标行 19(16×1.2) + 正文每行 22，
    // 再留 6px 下内边距。旧值 64 + 22n 少算 7px，真机上最后一行会顶到圆角边缘被裁。
    const lineHeight = 22
    const cardHeight = Math.max(100, 71 + safeLines.length * lineHeight)
    const bestTag = this.highestTag(tag)
    const showTag = this.canFitWithTag(word || "", bestTag)

    // 按真实字形宽度连续计算能填满卡片宽度的最大字号(无级缩放，避免阶梯式字号造成的"空隙感")。
    // getCharWidth 按翻译(700)标定，实际设备字形更宽且单词为 800 粗体，用 WORD_SCALE 补偿真实宽度；
    // 上一版用 1.4 仍偏小(出现右侧空隙)，说明真实比例低于 1.4，下调到 1.38 以贴满宽度且不再裁切。
    const headWidth = this.cardWidth - 24
    const tagReserve = showTag ? 8 + this.measureWordWidth(bestTag, 18) * 1.1 : 8
    const avail = headWidth - tagReserve
    const WORD_SCALE = 1.38
    const SAFETY = 1.05
    const unitW = this.measureWordWidth(word || "", 1) || 1
    let wordFontSize = 28
    let wordMarqueeOn = false
    const fitFont = Math.floor(avail / (unitW * WORD_SCALE * SAFETY))
    if (fitFont >= 28) {
      wordFontSize = 28
    } else if (fitFont >= 18) {
      wordFontSize = fitFont
    } else {
      wordMarqueeOn = true
      wordFontSize = 18
    }

    return {
      entryId: entryId,
      id: id,
      word: word,
      phonetic: phonetic ? "/" + phonetic + "/" : "",
      rawPhonetic: phonetic || "",
      translation: translation || "",
      translationLines: safeLines,
      tag: showTag ? bestTag : "",
      rawTag: bestTag,
      fullTag: tag,
      cardHeight: cardHeight,
      itemHeight: cardHeight + 10,
      wordMarqueeOn: wordMarqueeOn,
      wordFontSize: wordFontSize
    }
  },

  canFitWithTag(word, tag) {
    if (!tag) return true
    const WORD_FONT = 28
    const TAG_FONT = 18
    const TAG_MARGIN = 8
    const CARD_PADDING = 24
    const WORD_GLYPH_RATIO = 0.72
    const TAG_GLYPH_RATIO = 0.6
    const SAFETY = 4

    const safeLen = (word || "").length
    if (safeLen === 0) return true
    const wordW = safeLen * WORD_FONT * WORD_GLYPH_RATIO
    const tagW = tag.length * TAG_FONT * TAG_GLYPH_RATIO + TAG_MARGIN + SAFETY
    return wordW + tagW <= this.cardWidth - CARD_PADDING
  },

  // 正文折行专用度量：真机（212×520 截图逐字实测，18px/700）中文字形步进 18px、空格 5px、
  // 大写 14px、小写/数字 10px、ASCII 标点 6px。getCharWidth 是单词字号用的旧标定表（整体偏窄、
  // 靠 WORD_SCALE 补偿）；正文若沿用旧表，折出的每一行都远超 168px 内容宽，真机会按真实字形
  // 二次折行，而每行 <text> 只有一行高，后半行就被裁掉——这就是真机中文释义被截断的根因。
  wrapCharWidth(ch) {
    if (!ch) {
      return 0
    }
    if (
      (ch >= "\u2e80" && ch <= "\u9fff") ||
      (ch >= "\u2000" && ch <= "\u206f") ||
      (ch >= "\u2500" && ch <= "\u257f") ||
      (ch >= "\uff00" && ch <= "\uff60")
    ) {
      // CJK 部首/汉字、全角标点、通用标点（…—‘’“”）、制表符：中文语境一律按全角 18px 计
      return 18
    }
    if (ch === " ") {
      return 5
    }
    if (ch >= "A" && ch <= "Z") {
      return 14
    }
    if (ch >= "a" && ch <= "z") {
      return 10
    }
    if (ch >= "0" && ch <= "9") {
      return 10
    }
    if (
      ch === "." ||
      ch === "," ||
      ch === ";" ||
      ch === ":" ||
      ch === "/" ||
      ch === "-" ||
      ch === "\\" ||
      ch === "(" ||
      ch === ")" ||
      ch === "[" ||
      ch === "]" ||
      ch === "'" ||
      ch === "\""
    ) {
      return 6
    }
    return 10
  },

  wrapText(value, maxWidth) {
    const text = (value || "").replace(/\s+/g, " ").trim()
    if (!text) {
      return []
    }

    const lines = []
    let line = ""
    let width = 0
    let lastBreak = -1

    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      const chWidth = this.wrapCharWidth(ch)

      if (width + chWidth > maxWidth && line.length > 0) {
        if (lastBreak > 0) {
          lines.push(line.slice(0, lastBreak).trim())
          line = line.slice(lastBreak).trim() + ch
        } else {
          lines.push(line.trim())
          line = ch
        }
        width = this.measureTextWidth(line)
        lastBreak = this.findLastBreak(line)
      } else {
        line += ch
        width += chWidth
      }

      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        lastBreak = line.length
      }
    }

    if (line.trim()) {
      lines.push(line.trim())
    }
    return lines
  },

  // 仅用于 wrapText 的正文度量，必须与 wrapCharWidth 保持同一套真机字形表。
  measureTextWidth(value) {
    let width = 0
    for (let i = 0; i < value.length; i++) {
      width += this.wrapCharWidth(value.charAt(i))
    }
    return width
  },

  findLastBreak(value) {
    for (let i = value.length - 1; i >= 0; i--) {
      const ch = value.charAt(i)
      if (ch === " " || ch === ";" || ch === "," || ch === "，" || ch === "；") {
        return i + 1
      }
    }
    return -1
  },

  getCharWidth(ch) {
    if (!ch) {
      return 0
    }
    if (ch >= "\u4e00" && ch <= "\u9fff") {
      return 13
    }
    if (ch >= "A" && ch <= "Z") {
      return 8
    }
    if (ch >= "a" && ch <= "z") {
      return 7
    }
    if (ch >= "0" && ch <= "9") {
      return 7
    }
    if (
      ch === " " ||
      ch === "." ||
      ch === "," ||
      ch === ";" ||
      ch === ":" ||
      ch === "/" ||
      ch === "-"
    ) {
      return 4
    }
    return 8
  },

  measureWordWidth(word, font) {
    const s = word || ""
    let w = 0
    for (let i = 0; i < s.length; i++) {
      w += this.getCharWidth(s.charAt(i))
    }
    return w * (font / 18)
  },


  normalizeWord(value) {
    return (value || "").toLowerCase().trim()
  },

  isEnglishWord(value) {
    return /^[a-z][a-z' -]{0,30}$/.test(value || "")
  },

  showToast(message) {
    const now = Date.now()
    if (now - this.lastToastAt < this.toastCooldown) {
      return
    }
    this.lastToastAt = now
    prompt.showToast({
      message: message,
      duration: 1500
    })
  },

  onDestroy() {
    this.logCardMemory("destroy")
    this.destroyed = true
    this.onBackButtonTouchEnd()
    this._stopFlushTimer()
    this.entryCache = null
    this.cnIndexCache = null
    this.wrapCache = null
    this.pendingCards = null
    this.collectedIds = null
    this.historyCache = null
    this.shardIndex = null
    // 页面销毁后主动 GC，释放词典缓存（官方内存文档：及时 runGC 避免泄漏）
    if (typeof global !== "undefined" && typeof global.runGC === "function") {
      global.runGC()
    }
  },

  hasChinese(value) {
    const text = value || ""
    for (let i = 0; i < text.length; i++) {
      if (this.isChineseChar(text.charAt(i))) {
        return true
      }
    }
    return false
  },

  normalizeChineseText(value) {
    const text = value || ""
    let output = ""
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      if (this.isChineseChar(ch)) {
        output += ch
      }
    }
    return output
  },

  getFirstChineseChar(value) {
    const text = value || ""
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i)
      if (this.isChineseChar(ch)) {
        return ch
      }
    }
    return ""
  },

  isChineseChar(ch) {
    return ch >= "\u4e00" && ch <= "\u9fff"
  },

  zhBucketFor(ch) {
    return this.padHex(ch.charCodeAt(0) % 64)
  },

  cnBucketFor(ch) {
    return this.padHex(ch.charCodeAt(0) % 96)
  },

  padHex(value) {
    const hex = value.toString(16)
    if (hex.length < 2) {
      return "0" + hex
    }
    return hex
  },

  parseEntryId(value) {
    if (typeof value === "number") {
      if (value < 0 || value > MAX_SAFE_ENTRY_ID || Math.floor(value) !== value) {
        return -1
      }
      return value
    }
    if (typeof value !== "string" || !/^[0-9a-z]+$/.test(value)) {
      return -1
    }
    // ALWAYS base36 — word files encode entryId as to_base36(entry_id) in generate_watch_dict.py
    const id = parseInt(value, 36)
    if (id < 0 || id > MAX_SAFE_ENTRY_ID || Math.floor(id) !== id) {
      return -1
    }
    return id
  },

  entryShardFor(entryId) {
    const index = Math.floor(entryId / 500)
    if (index < 10) {
      return "0" + index
    }
    return "" + index
  },

  keyFor(value) {
    const word = this.normalizeWord(value)
    const first = word.charAt(0)
    return first >= "a" && first <= "z" ? first : "_"
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const sw = this.$app.$def.data.screenWidth || 212
    const startsInLeftQuarter = this.touchStartX <= sw * 0.25
    const endsAtRightQuarter = endX >= sw * 0.75
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

