<template>
  <div class="page page-{{screenProfile}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <image class="back-btn" src="/common/icons/btn_back.png" style="width:102px;height:72px;" onclick="goBack" />

    <div class="content">
      <text class="setting-title">首页布局</text>
      <div class="layout-row">
        <text class="layout-label {{layoutMode === 'classic' ? 'layout-active' : ''}}" onclick="setLayoutClassic">经典</text>
        <text class="layout-label layout-label-ml {{layoutMode === 'minimal' ? 'layout-active' : ''}}" onclick="setLayoutMinimal">简约</text>
      </div>

      <text class="setting-title sp-title">英文输入联想</text>
      <switch
        class="suggestion-switch"
        checked="{{ englishSuggestionEnabled }}"
        onchange="onSuggestionChange"
      ></switch>

      <text class="setting-title sp-title">结果页长按返回主页</text>
      <switch
        class="suggestion-switch"
        checked="{{ resultLongPressHomeEnabled }}"
        onchange="onResultLongPressHomeChange"
      ></switch>

      <div class="search-swipe-title">
        <text class="setting-title">搜索输入页</text>
        <text class="setting-title">强制不可滑动退出</text>
      </div>
      <switch
        class="suggestion-switch"
        checked="{{ searchSwipeExitLocked }}"
        onchange="onSearchSwipeExitChange"
      ></switch>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"

const {navGuard} = global

export default {
  private: {
    englishSuggestionEnabled: true,
    resultLongPressHomeEnabled: true,
    searchSwipeExitLocked: true,
    layoutMode: "minimal",
    screenProfile: "pill-standard",
    destroyed: false,
    touchStartX: -1,
    touchStartY: -1
  },

  onInit() {
    this.screenProfile = this.$app.$def.data.screenProfile || "pill-standard"
    this._loadSetting("dic_home_layout", "minimal", function(value) {
      if (value === "classic" || value === "minimal") {
        this.layoutMode = value
      }
    }.bind(this))
    this._loadSetting("dic_english_suggestions", "1", function(value) {
      this.englishSuggestionEnabled = value !== "0"
    }.bind(this))
    this._loadSetting("dic_result_long_press_home", "1", function(value) {
      this.resultLongPressHomeEnabled = value !== "0"
    }.bind(this))
    this._loadSetting("dic_search_swipe_exit_locked", "1", function(value) {
      this.searchSwipeExitLocked = value !== "0"
    }.bind(this))
  },

  _loadSetting(key, defaultVal, callback) {
    storage.get({
      key: key,
      default: defaultVal,
      success: function(data) {
        if (this.destroyed) return
        var value = data && (data.value || data)
        callback(value)
      }.bind(this),
      fail: function() {}
    })
  },

  onDestroy() {
    this.destroyed = true
  },

  goBack() {
    if (!navGuard()) {
      return
    }
    router.back()
  },

  setLayoutClassic() {
    if (this.layoutMode === "classic") return
    this.layoutMode = "classic"
    this._saveLayout("classic")
  },

  setLayoutMinimal() {
    if (this.layoutMode === "minimal") return
    this.layoutMode = "minimal"
    this._saveLayout("minimal")
  },

  _saveLayout(mode) {
    storage.set({
      key: "dic_home_layout",
      value: mode,
      fail: function(d, code) {
        console.log("settings layout save failed: " + code)
      }
    })
    prompt.showToast({ message: "重启生效", duration: 1500 })
  },

  onSuggestionChange(evt) {
    this.englishSuggestionEnabled = !!(evt && evt.checked)
    this.saveSwitch("dic_english_suggestions", this.englishSuggestionEnabled)
  },

  onResultLongPressHomeChange(evt) {
    this.resultLongPressHomeEnabled = !!(evt && evt.checked)
    this.saveSwitch("dic_result_long_press_home", this.resultLongPressHomeEnabled)
  },

  onSearchSwipeExitChange(evt) {
    this.searchSwipeExitLocked = !!(evt && evt.checked)
    this.saveSwitch("dic_search_swipe_exit_locked", this.searchSwipeExitLocked)
  },

  saveSwitch(key, enabled) {
    storage.set({
      key: key,
      value: enabled ? "1" : "0",
      fail: function(data, code) {
        console.log("settings storage.set failed: " + code)
      }
    })
  },

  onTouchStart(evt) {
    var point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    var point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }
    var endX = point.clientX
    var endY = point.clientY
    var screenWidth = this.$app.$def.data.screenWidth || 212
    var horizontal = Math.abs(endY - this.touchStartY) <= 120
    if (this.touchStartX <= screenWidth * 0.25 && endX >= screenWidth * 0.75 && horizontal) {
      router.back()
    }
    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 24px;
  background-color: #020813;
  flex-direction: column;
  align-items: center;
}





.content {
  width: 100%;
  margin-top: 50px;
  flex-direction: column;
  align-items: center;
}

.setting-title {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  line-height: 30px;
  text-align: center;
}

.sp-title {
  margin-top: 34px;
}

.suggestion-switch {
  width: 58px;
  height: 32px;
  margin-top: 16px;
  thumb-color: #ffffff;
  track-color: #0b65ea;
}

/* 布局切换器 */
.layout-row {
  margin-top: 14px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.layout-label {
  width: 72px;
  height: 36px;
  border-radius: 18px;
  border-width: 2px;
  border-color: #2a3a50;
  background-color: transparent;
  color: #6888b8;
  font-size: 20px;
  font-weight: 700;
  text-align: center;
  justify-content: center;
  align-items: center;
}

.layout-label-ml {
  margin-left: 12px;
}

.layout-active {
  border-color: #0b65ea;
  background-color: #0b65ea;
  color: #ffffff;
}

.search-swipe-title {
  margin-top: 34px;
  flex-direction: column;
  align-items: center;
}

.page-circle {
  padding-top: 16px;
}
</style>
