<template>
  <div class="page page-{{screenClass}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <image class="back-btn" src="/common/icons/btn_back.png" onclick="goBack" />

    <scroll class="settings-scroll settings-scroll-{{screenClass}}" scroll-y="true">
      <div class="content content-{{screenClass}}">

        <div if="{{supportsMinimal}}" class="setting-row setting-row-{{screenClass}}" onclick="toggleLayout">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">首页布局</text>
            <text class="setting-desc">{{ layoutReady ? (layoutMode === 'minimal' ? '简约布局' : '经典布局') : '读取中…' }}</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ layoutReady && layoutMode === 'minimal' ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

        <div class="setting-row setting-row-{{screenClass}}" onclick="toggleEnglishSuggestion">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">英文联想</text>
            <text class="setting-desc">英文候选词</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ englishSuggestionEnabled ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

        <div class="setting-row setting-row-{{screenClass}}" onclick="toggleResultLongPressHome">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">长按返回</text>
            <text class="setting-desc">结果页卡片</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ resultLongPressHomeEnabled ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

        <div class="setting-row setting-row-{{screenClass}}" onclick="toggleSearchSwipeExit">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">滑动锁定</text>
            <text class="setting-desc">搜索输入页</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ searchSwipeExitLocked ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

        <div class="setting-row setting-row-{{screenClass}}" onclick="toggleBtnScale">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">按钮缩放</text>
            <text class="setting-desc">点击动效</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ btnScaleEnabled ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

        <div class="setting-row setting-row-{{screenClass}}" onclick="toggleKeepScreenOn">
          <div class="setting-text setting-text-{{screenClass}}">
            <text class="setting-name">屏幕常亮</text>
            <text class="setting-desc">保持亮屏</text>
          </div>
          <image
            class="switch-img switch-img-{{screenClass}}"
            src="{{ keepScreenOnEnabled ? '/common/images/switch-on.png' : '/common/images/switch-off.png' }}"
          ></image>
        </div>

      </div>
    </scroll>
  </div>
</template>

<script>
import {appScreenClass, currentScreenClass, supportsMinimalLayout} from "../../common/screenColumn"
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"
import {applyKeepScreenOnSetting, setKeepScreenOnEnabled} from "../../common/keepScreenOn"

const {navGuard} = global

export default {
  private: {
    screenClass: currentScreenClass(),
    englishSuggestionEnabled: false,
    resultLongPressHomeEnabled: true,
    searchSwipeExitLocked: true,
    btnScaleEnabled: true,
    keepScreenOnEnabled: false,
    // 布局在存储读完前未知：先不高亮任何一项，避免先亮「简约」再跳到「经典」
    layoutMode: "",
    layoutReady: false,
    // 首帧一律不给入口，等 onInit/onShow 按真实列算出结果再显示：
    // 调试包里 screenClass 初值是 buildTarget.width（212），屏幕探测是异步的，
    // 默认 true 会让 336/432/466 在探测完成前闪出「首页布局」开关。
    supportsMinimal: false,
    screenProfile: "pill-standard",
    destroyed: false,
    touchStartX: -1,
    touchStartY: -1
  },

  onInit() {


    this.screenClass = appScreenClass(this)
    this.supportsMinimal = supportsMinimalLayout(this.screenClass)
    this.screenProfile = this.$app.$def.data.screenProfile || "pill-standard"
    // 同一会话里首页已经读过布局，直接复用：本页首帧就能选中正确项，不闪
    var cachedLayout = this.$app.$def.data.layoutMode
    if (this.supportsMinimal && (cachedLayout === "classic" || cachedLayout === "minimal")) {
      this.layoutMode = cachedLayout
      this.layoutReady = true
    }
    this._loadSetting("dic_home_layout", "minimal", function(value) {
      if (value === "classic" || value === "minimal") {
        this.layoutMode = this.supportsMinimal ? value : "classic"
        this.layoutReady = true
      }
    }.bind(this))
    this._loadSetting("dic_english_suggestions", "0", function(value) {
      this.englishSuggestionEnabled = value !== "0"
    }.bind(this))
    this._loadSetting("dic_result_long_press_home", "1", function(value) {
      this.resultLongPressHomeEnabled = value !== "0"
    }.bind(this))
    this._loadSetting("dic_search_swipe_exit_locked", "1", function(value) {
      this.searchSwipeExitLocked = value !== "0"
    }.bind(this))
    this._loadSetting("dic_button_scale", "1", function(value) {
      this.btnScaleEnabled = value === "1"
    }.bind(this))
    applyKeepScreenOnSetting(function(enabled) {
      this.keepScreenOnEnabled = enabled
    }.bind(this))
  },

  _loadSetting(key, defaultVal, callback) {
    storage.get({
      key: key,
      default: defaultVal,
      success: function(data) {
        if (this.destroyed) return
        var value = data && (data.value || data)
        callback(value)
      }.bind(this),
      fail: function() {}
    })
  },

  onShow() {
    // 探测结果可能晚于本页首帧：每次显示都重取一次列，避免残留 212 的判断
    this.screenClass = appScreenClass(this)
    this.supportsMinimal = supportsMinimalLayout(this.screenClass)
    if (!this.supportsMinimal && this.layoutMode !== "classic") {
      this.layoutMode = "classic"
      this.layoutReady = true
    }
  },

  onDestroy() {
    this.destroyed = true
  },

  goBack() {
    if (!navGuard()) {
      return
    }
    router.back()
  },

  toggleLayout() {
    if (!this.layoutReady || !this.supportsMinimal) return
    if (this.layoutMode === "minimal") {
      this.setLayoutClassic()
    } else {
      this.setLayoutMinimal()
    }
  },

  setLayoutClassic() {
    if (this.layoutMode === "classic") return
    this.layoutMode = "classic"
    this.layoutReady = true
    this._saveLayout("classic")
  },

  setLayoutMinimal() {
    if (!this.supportsMinimal) return
    if (this.layoutMode === "minimal") return
    this.layoutMode = "minimal"
    this.layoutReady = true
    this._saveLayout("minimal")
  },

  _saveLayout(mode) {
    // 同步更新会话缓存：本页被重新创建时首帧仍能选中正确项
    var def = this.$app && this.$app.$def
    if (def && def.data) {
      def.data.layoutMode = mode
    }
    storage.set({
      key: "dic_home_layout",
      value: mode,
      fail: function(d, code) {
        console.log("settings layout save failed: " + code)
      }
    })
    prompt.showToast({ message: "重启生效", duration: 1500 })
  },

  toggleEnglishSuggestion() {
    this.englishSuggestionEnabled = !this.englishSuggestionEnabled
    this.saveSwitch("dic_english_suggestions", this.englishSuggestionEnabled)
  },

  toggleResultLongPressHome() {
    this.resultLongPressHomeEnabled = !this.resultLongPressHomeEnabled
    this.saveSwitch("dic_result_long_press_home", this.resultLongPressHomeEnabled)
  },

  toggleSearchSwipeExit() {
    this.searchSwipeExitLocked = !this.searchSwipeExitLocked
    this.saveSwitch("dic_search_swipe_exit_locked", this.searchSwipeExitLocked)
  },

  toggleBtnScale() {
    this.btnScaleEnabled = !this.btnScaleEnabled
    this.saveSwitch("dic_button_scale", this.btnScaleEnabled)
  },

  toggleKeepScreenOn() {
    this.keepScreenOnEnabled = !this.keepScreenOnEnabled
    setKeepScreenOnEnabled(this.keepScreenOnEnabled)
    this.saveSwitch("dic_keep_screen_on", this.keepScreenOnEnabled)
  },

  saveSwitch(key, enabled) {
    storage.set({
      key: key,
      value: enabled ? "1" : "0",
      fail: function(data, code) {
        console.log("settings storage.set failed: " + code)
      }
    })
  },

  onTouchStart(evt) {
    var point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    var point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }
    var endX = point.clientX
    var endY = point.clientY
    var screenWidth = this.$app.$def.data.screenWidth || 212
    var horizontal = Math.abs(endY - this.touchStartY) <= 120
    if (this.touchStartX <= screenWidth * 0.25 && endX >= screenWidth * 0.75 && horizontal) {
      router.back()
    }
    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>

.back-btn {
  width: 102px;
  height: 72px;
}

.page {
  width: 100%;
  height: 100%;
  padding-top: 24px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.settings-scroll {
  width: 100%;
  height: 424px;
  flex-direction: column;
  align-items: center;
}

.content {
  width: 100%;
  margin-top: 16px;
  padding-bottom: 12px;
  flex-direction: column;
  align-items: center;
}

/* 设置项卡片：左描述、右开关图片（素材与解包天气 App 一致） */
.setting-row {
  width: 196px;
  height: 60px;
  margin-top: 6px;
  padding-left: 12px;
  padding-right: 10px;
  border-radius: 18px;
  background-color: rgba(255, 255, 255, 0.15);
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.setting-text {
  width: 108px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.setting-name {
  width: 100%;
  color: #ffffff;
  font-size: 22px;
  font-weight: 700;
  line-height: 26px;
  text-align: left;
}

.setting-desc {
  width: 100%;
  color: rgba(255, 255, 255, 0.6);
  font-size: 18px;
  line-height: 20px;
  text-align: left;
}

.switch-img {
  width: 58px;
  height: 33px;
}

/* 192：最窄的胶囊屏，卡片与开关再收一点 */
.setting-row-192 {
  width: 176px;
  height: 58px;
  padding-left: 10px;
  padding-right: 8px;
}

.setting-text-192 {
  width: 96px;
}

.switch-img-192 {
  width: 52px;
  height: 30px;
}

/* 336 / 432：矩形屏，卡片贴边留 8px */
.setting-row-336 {
  width: 320px;
  height: 64px;
  padding-left: 16px;
  padding-right: 12px;
}

.setting-text-336 {
  width: 222px;
}

.switch-img-336 {
  width: 62px;
  height: 35px;
}

.setting-row-432 {
  width: 416px;
  height: 62px;
  padding-left: 18px;
  padding-right: 14px;
}

.setting-text-432 {
  width: 306px;
}

.switch-img-432 {
  width: 66px;
  height: 38px;
}

/* 466：圆形屏，卡片宽取内接正方形附近，避免上下被圆边裁切 */
.setting-row-466 {
  width: 330px;
  height: 62px;
  padding-left: 18px;
  padding-right: 14px;
}

.setting-text-466 {
  width: 232px;
}

.switch-img-466 {
  width: 60px;
  height: 34px;
}

.page-336 {
  width: 100%;
  height: 100%;
  padding-top: 8px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.page-432 {
  width: 100%;
  height: 100%;
  padding-top: 8px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.page-466 {
  width: 100%;
  height: 100%;
  padding-top: 16px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.settings-scroll-192 {
  width: 100%;
  height: 400px;
  flex-direction: column;
  align-items: center;
}

.settings-scroll-336 {
  width: 100%;
  height: 394px;
  flex-direction: column;
  align-items: center;
}

.settings-scroll-432 {
  width: 100%;
  height: 428px;
  flex-direction: column;
  align-items: center;
}

.settings-scroll-466 {
  width: 100%;
  height: 378px;
  flex-direction: column;
  align-items: center;
}

.content-192 {
  width: 100%;
  margin-top: 12px;
  flex-direction: column;
  align-items: center;
}

.content-336 {
  width: 100%;
  margin-top: 16px;
  flex-direction: column;
  align-items: center;
}

.content-432 {
  width: 100%;
  margin-top: 16px;
  flex-direction: column;
  align-items: center;
}

.content-466 {
  width: 100%;
  margin-top: 18px;
  flex-direction: column;
  align-items: center;
}

</style>
