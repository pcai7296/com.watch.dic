<template>
  <div class="page page-{{screenClass}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <image class="back-btn" src="/common/icons/btn_back.png" onclick="goBack" />

    <img class="sponsor-code sponsor-code-{{screenClass}}" src="/common/sponsor-code.png" />
    <text class="sponsor-caption">求喂饭</text>
  </div>
</template>

<script>
import {appScreenClass, currentScreenClass} from "../../common/screenColumn"
import router from "@system.router"
import {applyKeepScreenOnSetting} from "../../common/keepScreenOn"

const {navGuard} = global

export default {
  private: {
    screenClass: currentScreenClass(),
    touchStartX: -1,
    touchStartY: -1
  },

  onShow() {


    this.screenClass = appScreenClass(this)
    applyKeepScreenOnSetting()
  },

  goBack() {
    if (!navGuard()) {
      return
    }
    router.back()
  },

  onTouchStart(evt) {
    const point = this.getTouchPoint(evt)
    if (point) {
      this.touchStartX = point.clientX
      this.touchStartY = point.clientY
    }
  },

  onTouchEnd(evt) {
    const point = this.getTouchPoint(evt)
    if (!point || this.touchStartX < 0) {
      return
    }

    const endX = point.clientX
    const endY = point.clientY
    const sw = this.$app.$def.data.screenWidth || 212
    const startsInLeftQuarter = this.touchStartX <= sw * 0.25
    const endsAtRightQuarter = endX >= sw * 0.75
    const mostlyHorizontal = Math.abs(endY - this.touchStartY) <= 120

    if (startsInLeftQuarter && endsAtRightQuarter && mostlyHorizontal) {
      router.back()
    }

    this.touchStartX = -1
    this.touchStartY = -1
  },

  getTouchPoint(evt) {
    if (evt && evt.changedTouches && evt.changedTouches.length > 0) {
      return evt.changedTouches[0]
    }
    if (evt && evt.touches && evt.touches.length > 0) {
      return evt.touches[0]
    }
    return null
  }
}
</script>

<style>
.back-btn {
  width: 102px;
  height: 72px;
}

.page {
  width: 100%;
  height: 100%;
  padding-top: 24px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.sponsor-code {
  width: 188px;
  height: 188px;
  margin-top: 68px;
}

.sponsor-caption {
  margin-top: 16px;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
  text-align: center;
}

.page-432 {
  width: 100%;
  height: 100%;
  padding-top: 8px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.page-466 {
  width: 466px;
  height: 466px;
  padding-top: 0;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.sponsor-code-466 {
  width: 188px;
  height: 188px;
  margin-top: 30px;
}
</style>
